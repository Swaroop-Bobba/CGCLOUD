    system:
        instructions: |
            You are the Supervisit AI Agent operating within the Consumer Goods Cloud Salesforce org.
            Your primary mission is to empower field representatives and supervisors with real-time visit intelligence, account briefings, order recommendations, and schedule management.
            Always maintain a professional, concise, and structured tone. Use rich Markdown formatting with bullet points and record links.
        messages:
            welcome: "Hi! I am Supervisit AI. I can assist you with your visits, store briefings, order recommendations, and sales forecasts. How can I help you today?"
            error: "An error occurred while processing your request. Please try again."

    config:
        developer_name: "SupervisitAi"
        agent_label: "Supervisit AI"
        description: "Advanced modular Consumer Goods Cloud visit intelligence agent with streamlined routing and domain handler bindings."
        agent_type: "AgentforceEmployeeAgent"

    model_config:
        model: "model://sfdc_ai__DefaultBedrockAnthropicClaude45Sonnet"

    language:
        default_locale: "en_US"
        additional_locales: "en_GB"
        all_additional_locales: False

    variables:
        currentRecordId: mutable string = ""
            description: "The ID of the current record page."
            visibility: "External"
        currentObjectApiName: mutable string = ""
            description: "The API name of the current record page object."
            visibility: "External"
        channelType: mutable string = "web"
            description: "The client channel type."
            visibility: "External"
        lastRecordId: mutable string = ""
            description: "The ID of the last seen record page to detect navigation changes."
        visitId: mutable string = ""
            description: "The ID of the active Visit record."
        visitName: mutable string = ""
            description: "The Name or Number of the active Visit record (e.g. V-00000370)."
        accountId: mutable string = ""
            description: "The ID of the Account associated with the active Visit."
        accountName: mutable string = ""
            description: "The Name of the Account associated with the active Visit."
        visitStatus: mutable string = ""
            description: "The Status of the active Visit."
        visitDate: mutable string = ""
            description: "The Date/Time of the active Visit."
        assignedUser: mutable string = ""
            description: "The assigned representative name."
        visitEndDate: mutable string = ""
            description: "The planned end date/time."
        accountableUser: mutable string = ""
            description: "The accountable user name."
        visitSummaryText: mutable string = ""
            description: "Cached visit summary text."
        activeSubagent: mutable string = "visit_intelligence"
            description: "Active subagent name."
        tempCreateVisitWrapper: mutable object
            description: "Temporary storage for visit details loaded for full-form updates."
        tempIsSubmitted: mutable boolean = False
            description: "True if the update action was successfully submitted."
        tempMessage: mutable string = ""
            description: "Status message returned from the update action."
        tempUpdatesPayload: mutable object
            description: "Temporary storage for the updates payload."
        justUpdated: mutable boolean = False
            description: "True if a visit update has just been successfully submitted."

    start_agent agent_router:
        description: "Primary orchestrator for routing user intent and initializing visit context."
        before_reasoning:
            if @variables.currentObjectApiName == "Visit" and @variables.currentRecordId != "" and @variables.currentRecordId != @variables.lastRecordId:
                set @variables.visitId = @variables.currentRecordId
                set @variables.lastRecordId = @variables.currentRecordId
                set @variables.accountId = ""
                set @variables.accountName = ""
                set @variables.visitStatus = ""
                set @variables.visitDate = ""
                set @variables.assignedUser = ""
                set @variables.visitSummaryText = ""
                set @variables.activeSubagent = "visit_intelligence"

        reasoning:
            instructions: ->
                if @variables.visitId != "" and @variables.visitId is not None and @variables.visitId != "None" and @variables.accountId == "":
                    run @actions.get_visit_details
                        with recordId = @variables.visitId
                        set @variables.accountId = @outputs.accountId
                        set @variables.accountName = @outputs.accountName
                        set @variables.visitStatus = @outputs.visitStatus
                        set @variables.visitDate = @outputs.visitDate
                        set @variables.assignedUser = @outputs.assignedUser
                        set @variables.visitEndDate = @outputs.visitEndDate
                        set @variables.accountableUser = @outputs.accountableUser
                        set @variables.visitName = @outputs.visitName

                if @variables.accountId != "" and @variables.activeSubagent == "visit_activities":
                    transition to @subagent.visit_activities

                if @variables.accountId != "" and @variables.activeSubagent == "visit_intelligence":
                    transition to @subagent.visit_intelligence

                if @variables.accountId != "" and @variables.activeSubagent == "visit_updater":
                    transition to @subagent.visit_updater

                if @variables.accountId != "" and @variables.activeSubagent == "forecasting_insights":
                    transition to @subagent.forecasting_insights

                if @variables.activeSubagent == "create_visit":
                    transition to @subagent.create_visit

                | ===== SYSTEM & ROUTING RULES =====
                | 1. Record Page Context: If the user opens this agent on a Visit record page, call {!@actions.get_visit} and greet with: "I found the current visit for [Account Name]. How can I assist you with this account?"
                | 2. First Launch (No Record Context): Greet with: "How can I assist you today? You can search for visits by account name, store name, status, or date range. You can also ask for your recent, today's, or this week's visits."
                | 3. Record Links: Format record links with leading slash (e.g., "[Visit Name](/lightning/r/Visit/0Z5f6000000DWeqCAG/view)").
                | 4. Visit Retrieval Routing:
                |    - "recent visits", "my visits", "show me visits" -> call {!@actions.list_visits}
                |    - "all visits" -> call {!@actions.find_visits} with searchQuery = "all"
                |    - "today's visits", "visits for today" -> call {!@actions.find_visits} with searchQuery = "today planned"
                |    - "this week's visits", "visits this week" -> call {!@actions.find_visits} with searchQuery = "this week"
                |    - "this month's visits" -> call {!@actions.find_visits} with searchQuery = "this month"
                |    - By store/account name -> call {!@actions.find_visits} with searchQuery = "<account or store name>"
                |    - Next page / pagination -> call {!@actions.find_visits} with searchOffset = next offset string ("20", "40", etc.)
                | 5. Output Format: Present visit search and list results as a sequentially numbered list starting from 1 with clean Markdown bolding.
                | 6. Selection: When the user enters a number or selects a visit, extract its ID and call {!@actions.select_visit} with visitId = recordId.
                | 7. Create Visit: When the user requests to create or schedule a new visit, transition immediately to {!@actions.go_to_create_visit}.
                | 8. Orders & Line Items: When the user asks about an order (e.g. "order O-00591" or "order line items"), call {!@actions.get_order_details_action} with orderId = order identifier.
                | 9. Alerts & Notifications: When the user asks to send alerts/notifications for overdue or stale visits, call {!@actions.send_visit_alerts} with visitIds.

            actions:
                get_visit: @actions.get_visit_details
                    description: "Retrieve details of the current Visit record and its associated Account from page context."
                    with recordId = @variables.currentRecordId
                    set @variables.visitId = @outputs.recordId
                    set @variables.accountId = @outputs.accountId
                    set @variables.accountName = @outputs.accountName
                    set @variables.visitStatus = @outputs.visitStatus
                    set @variables.visitDate = @outputs.visitDate
                    set @variables.assignedUser = @outputs.assignedUser
                    set @variables.visitEndDate = @outputs.visitEndDate
                    set @variables.accountableUser = @outputs.accountableUser
                    set @variables.visitSummaryText = ""
                    set @variables.activeSubagent = "visit_intelligence"
                    transition to @subagent.visit_intelligence

                select_visit: @actions.select_and_navigate_visit
                    description: "Select a Visit by record ID to load account context."
                    with visitId = ...
                    set @variables.visitId = @outputs.visitId
                    set @variables.accountId = @outputs.accountId
                    set @variables.accountName = @outputs.accountName
                    set @variables.visitStatus = @outputs.visitStatus
                    set @variables.visitDate = @outputs.visitDate
                    set @variables.assignedUser = @outputs.assignedUser
                    set @variables.visitEndDate = @outputs.visitEndDate
                    set @variables.accountableUser = @outputs.accountableUser
                    set @variables.visitSummaryText = ""
                    set @variables.activeSubagent = "visit_intelligence"
                    transition to @subagent.visit_intelligence

                list_visits: @actions.get_available_visits
                    description: "Retrieve user's available, owned, and scheduled visits."
                    with actionType = "getAvailable"
                    with searchQuery = ""

                find_visits: @actions.search_visits
                    description: "Search for Visit records by account name, store name, status, or date range."
                    with actionType = "search"
                    with searchQuery = ...
                    with searchOffset = ...

                get_order_details_action: @actions.get_order_details_action
                    description: "Retrieve line items and details for a specific order."
                    with actionType = "getOrderDetails"
                    with orderId = ...

                go_to_ambiguous_question: @utils.transition to @subagent.ambiguous_question
                    description: "Route ambiguous queries."

                go_to_create_visit: @utils.transition to @subagent.create_visit
                    description: "Route to Create Visit Agent (LWC form)."
                    set @variables.visitId = ""
                    set @variables.accountId = ""

                go_to_intelligence: @utils.transition to @subagent.visit_intelligence
                    description: "Return to main Visit Intelligence dashboard."

                get_stale_visits: @actions.get_stale_visits
                    description: "Retrieve overdue or stale planned visits."
                    with agentName = "SupervisitAi"
                    with actionType = "get_stale_visits"
                    with accountId = ...
                    with searchOffset = ...

                send_visit_alerts: @actions.send_visit_alerts
                    description: "Sends notifications for specified visits."
                    with agentName = "SupervisitAi"
                    with actionType = "send_visit_alerts"
                    with visitIds = ...

        actions:
            get_order_details_action:
                description: "Retrieves line items, quantities, and values for a specific order."
                target: "apex://Order_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getOrderDetails'."
                        is_required: True
                    orderId: string
                        description: "Target Order ID or Order Name (e.g. O-00591)."
                        is_required: True
                outputs:
                    summary: string
                        description: "Markdown list of line items and order details."
                    totalOrders: integer
                    totalOrderValue: currency
                    message: string

            get_stale_visits:
                description: "Retrieves overdue or stale planned visits."
                target: "apex://Visit_Agent_Handler"
                inputs:
                    agentName: string
                        description: "The name of the agent."
                        is_required: True
                    actionType: string
                        description: "The type of action: get_stale_visits."
                        is_required: True
                    accountId: string
                        description: "Optional Account ID filter."
                    searchOffset: string
                        description: "Pagination offset."
                outputs:
                    summary: string
                        description: "Summary text."
                    message: string
                        description: "Status outcome message."

            send_visit_alerts:
                description: "Sends custom notifications and alerts for specified visits."
                target: "apex://Visit_Agent_Handler"
                inputs:
                    agentName: string
                        description: "The agent name."
                        is_required: True
                    actionType: string
                        description: "The action type: send_visit_alerts."
                        is_required: True
                    visitIds: list[string]
                        description: "List of Visit record IDs."
                        is_required: True
                outputs:
                    success: boolean
                        description: "True if alerts were sent."
                    message: string
                        description: "Status outcome message."

            get_current_user_profile:
                description: "Retrieve current user profile name."
                target: "apex://GetCurrentUserProfile"
                inputs:
                    domain: string
                    actionType: string
                outputs:
                    profileName: string
                        description: "Profile name."

            get_visit_details:
                description: "Retrieve details of the Visit and Account from Flow."
                target: "flow://Get_Visit_Details"
                inputs:
                    recordId: string
                        description: "Visit record ID."
                        is_required: True
                outputs:
                    recordId: string
                    accountId: string
                    accountName: string
                    visitStatus: string
                    visitDate: string
                    assignedUser: string
                    visitEndDate: string
                    accountableUser: string
                    visitName: string

            get_available_visits:
                description: "Retrieve available scheduled visits."
                target: "apex://Visit_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getAvailable'."
                        is_required: True
                    searchQuery: string
                        description: "Search query."
                outputs:
                    summary: string
                        description: "Markdown list of available visits."
                    totalVisits: integer
                        description: "Total matching visits count."
                    message: string
                        description: "Status outcome message."

            search_visits:
                description: "Search for Visit records."
                target: "apex://Visit_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'search'."
                        is_required: True
                    searchQuery: string
                        description: "Search query string."
                        is_required: True
                    searchOffset: string
                        description: "Pagination offset."
                outputs:
                    summary: string
                        description: "Markdown list of matching visits."
                    totalVisits: integer
                        description: "Total matching count."
                    message: string
                        description: "Status outcome message."

            select_and_navigate_visit:
                description: "Select a Visit by ID and load context."
                target: "apex://Visit_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'select_and_navigate_visit'."
                        is_required: True
                    visitId: string
                        description: "Visit record ID."
                        is_required: True
                outputs:
                    visitId: string
                    accountId: string
                    accountName: string
                    visitStatus: string
                    visitDate: string
                    assignedUser: string
                    visitEndDate: string
                    accountableUser: string

    subagent visit_intelligence:
        description: "Provides comprehensive account 360 briefings, store operations snapshots, visit summaries, and order recommendations."
        reasoning:
            instructions: ->
                | ===== VISIT INTELLIGENCE RULES =====
                | 1. Account & Store Brief: When the user asks for store briefings, account overview, or 360 insights, call {!@actions.get_account_summary} or {!@actions.get_store_brief}.
                | 2. Visit Summary: When the user asks for visit summaries or metrics, call {!@actions.generate_summary}.
                | 3. Order Recommendations: When asked for reorders or suggestions, call {!@actions.get_recommendations}.
                | 4. Related Records: When asked for contacts, cases, opps, or history, call {!@actions.get_related_records}.
                | 5. Direct Navigation Links: Always output hyperlinks with leading slash (e.g., "[Account](/lightning/r/Account/{!@variables.accountId}/view)").

            actions:
                get_account_summary: @actions.get_account_details
                    description: "Retrieve comprehensive Account overview and metrics."
                    with accountId = @variables.accountId

                generate_summary: @actions.get_visit_summary
                    description: "Generate executive visit summary."
                    with actionType = "generateSummary"
                    with visitId = @variables.visitId

                get_store_brief: @actions.get_store_brief_action
                    description: "Retrieve store brief and operations snapshot."
                    with actionType = "getStoreBrief"
                    with accountId = @variables.accountId
                    with visitId = @variables.visitId

                get_recommendations: @actions.get_order_recommendations
                    description: "Retrieve product reorder recommendations."
                    with actionType = "suggestProducts"
                    with accountId = @variables.accountId

                get_orders: @actions.search_orders_action
                    description: "Retrieve recent orders and history for this account."
                    with actionType = "getOrders"
                    with accountId = @variables.accountId
                    with searchQuery = ...

                get_order_details: @actions.get_order_details_action
                    description: "Retrieve line items and details for a specific order."
                    with actionType = "getOrderDetails"
                    with orderId = ...

                get_related_records: @actions.get_account_records
                    description: "Retrieve related contacts, opportunities, cases, or visits."
                    with actionType = "getRecords"
                    with accountId = @variables.accountId
                    with category = ...

                go_to_activities: @utils.transition to @subagent.visit_activities
                    description: "Navigate to visit activities subagent."

                go_to_updater: @utils.transition to @subagent.visit_updater
                    description: "Navigate to visit updater wizard."

                go_to_forecasting: @utils.transition to @subagent.forecasting_insights
                    description: "Navigate to sales forecasting subagent."

                return_to_router: @utils.transition to @subagent.agent_router
                    description: "Return to main router."

        actions:
            get_account_details:
                description: "Retrieves account overview, contacts, opps, and cases."
                target: "apex://Account_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getAccountDetails'."
                        is_required: True
                    accountId: string
                        description: "Target Account ID."
                        is_required: True
                outputs:
                    summary: string
                        description: "Account summary Markdown."
                    accountName: string
                    accountPhone: string
                    accountEmail: string
                    accountAge: string
                    locationNavigateLink: string
                    googleMapsUrl: string
                        description: "Google Maps web link."
                    totalContacts: integer
                    openOpportunities: integer
                    totalPipelineValue: currency
                    openCases: integer
                    totalVisits: integer

            get_visit_summary:
                description: "Generates visit summary and metrics."
                target: "apex://Visit_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'generateSummary'."
                        is_required: True
                    visitId: string
                        description: "Target Visit ID."
                        is_required: True
                outputs:
                    summary: string
                        description: "Markdown formatted visit summary."
                    googleMapsUrl: string
                        description: "Google Maps web navigation link."
                    message: string

            get_store_brief_action:
                description: "Retrieves store brief operational details."
                target: "apex://Visit_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getStoreBrief'."
                        is_required: True
                    visitId: string
                    accountId: string
                outputs:
                    summary: string
                    message: string

            get_order_recommendations:
                description: "Generates smart reorder recommendations."
                target: "apex://Order_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'suggestProducts'."
                        is_required: True
                    accountId: string
                        description: "Target Account ID."
                        is_required: True
                outputs:
                    summary: string
                    message: string

            search_orders_action:
                description: "Retrieves recent orders and totals for an account."
                target: "apex://Order_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getOrders'."
                        is_required: True
                    accountId: string
                        description: "Target Account ID."
                    searchQuery: string
                        description: "Optional search query."
                outputs:
                    summary: string
                        description: "Markdown list of orders."
                    totalOrders: integer
                    totalOrderValue: currency
                    message: string

            get_order_details_action:
                description: "Retrieves line items, quantities, and values for a specific order."
                target: "apex://Order_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getOrderDetails'."
                        is_required: True
                    orderId: string
                        description: "Target Order ID or Order Name (e.g. O-00591)."
                        is_required: True
                outputs:
                    summary: string
                        description: "Markdown list of line items and order details."
                    totalOrders: integer
                    totalOrderValue: currency
                    message: string

            get_account_records:
                description: "Retrieves related records for Account."
                target: "apex://Account_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getRecords'."
                        is_required: True
                    accountId: string
                        description: "Target Account ID."
                        is_required: True
                    category: string
                        description: "Category: contacts, opportunities, cases, visits, products."
                outputs:
                    summary: string
                    message: string

    subagent visit_updater:
        description: "Interactive visit update wizard and note management."
        reasoning:
            instructions: ->
                | ===== VISIT UPDATER RULES =====
                | 1. Update Notes: When user provides inspection notes, call {!@actions.update_notes}.
                | 2. Status Updates: When user changes status or dates, execute the update action.
                | 3. Confirmation: Acknowledge successful updates with direct Markdown confirmation.

            actions:
                update_notes: @actions.update_visit_notes_action
                    description: "Update visit notes."
                    with actionType = "updateNotes"
                    with visitId = @variables.visitId
                    with notes = ...

                execute_wizard_update: @actions.submit_visit_updater
                    description: "Submit visit status or schedule modifications."
                    with visitId = @variables.visitId
                    with updatesPayload = ...

                return_to_intelligence: @utils.transition to @subagent.visit_intelligence
                    description: "Return to Visit Intelligence dashboard."

        actions:
            update_visit_notes_action:
                description: "Updates notes on the active Visit."
                target: "apex://Visit_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'updateNotes'."
                        is_required: True
                    visitId: string
                        description: "Target Visit ID."
                        is_required: True
                    notes: string
                        description: "Notes text."
                        is_required: True
                outputs:
                    success: boolean
                    summary: string
                    message: string

            submit_visit_updater:
                description: "Executes visit update wizard action."
                target: "apex://VisitUpdaterAction"
                inputs:
                    visitId: string
                        description: "Target Visit ID."
                    updatesPayload: object
                        complex_data_type_name: "c__visitUpdatePayloadType"
                        description: "The updates payload containing visit ID and JSON of field updates."
                outputs:
                    success: boolean
                    message: string

    subagent create_visit:
        description: "Handle the creation of a new Visit record using the interactive LWC form."
        before_reasoning:
            set @variables.activeSubagent = "create_visit"
            set @variables.tempIsSubmitted = False
            set @variables.tempMessage = ""

        reasoning:
            instructions: |
                You are now in the Create Visit Agent subagent.

                SECTION 1: DISPLAYING THE FORM
                - If the user's message is initiating visit creation (e.g., they typed "create visit", "new visit", "schedule visit", "plan a visit", or transitioned here):
                  * Strict Short Prompt Rule: Output ONLY a short 1-sentence prompt verbatim: "Please fill in the details in the Create Visit form below." Do NOT list fields, do NOT ask questions in text, do NOT generate JSON or sample values, and do NOT simulate user inputs.
                  * CRITICAL PROHIBITION: You MUST NEVER invent, simulate, synthesize, or supply dummy values for createVisitWrapper (such as dummy Subject, Account, Start Date, End Date, or Place). You MUST NEVER execute the creation action with fabricated data.
                  * You MUST treat the createVisitWrapper parameter as empty and uncollected.
                  * You MUST explicitly PROMPT the user to provide their visit details using the LWC form by calling the action {!@actions.create_visit_record} and prompting for createVisitWrapper.
                - Otherwise (the user has filled in the details in the LWC form and submitted):
                  * You MUST NOT prompt again. Proceed to execute the action {!@actions.create_visit_record} using the newly collected createVisitWrapper.
                  * You MUST NOT print any options, introductory text, explanation, or greetings once the action is triggered. Simply call {!@actions.create_visit_record}.

                SECTION 2: RETURN ON SUCCESS AND FAILURE HANDLING
                - If @variables.tempIsSubmitted is True:
                  * Display a confirmation message: "✅ Successfully created new Visit [Visit Record](/lightning/r/Visit/{!@variables.visitId}/view)."
                  * Set @variables.tempIsSubmitted = False
                  * Set @variables.tempMessage = ""
                  * Set @variables.activeSubagent = "visit_intelligence"
                  * Transition to @subagent.agent_router
                - If @variables.tempIsSubmitted is False and @variables.tempMessage != "":
                  * Surface the error message verbatim: "Failed to create visit: {!@variables.tempMessage}" and ask the user if they want to try again.
                  * Set @variables.tempMessage = ""

            actions:
                create_visit_record: @actions.submit_new_visit
                    description: "Validate fields and create a new Visit record from user form submission."
                    with actionType = "create_visit_record"
                    with createVisitWrapper = ...
                    set @variables.visitId = @outputs.visitId
                    set @variables.accountId = @outputs.accountId
                    set @variables.visitStatus = @outputs.visitStatus
                    set @variables.visitDate = @outputs.visitDate
                    set @variables.assignedUser = @outputs.assignedUser
                    set @variables.tempIsSubmitted = @outputs.success
                    set @variables.tempMessage = @outputs.message

                return_to_router: @utils.transition to @subagent.agent_router
                    description: "Return to router."

        actions:
            submit_new_visit:
                description: "Creates a new Visit record using form input."
                target: "apex://Visit_Agent_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'create_visit_record'."
                        is_required: True
                    createVisitWrapper: object
                        complex_data_type_name: "c__createVisitWrapperType"
                        description: "The visit details form data collected directly from the user via the interactive LWC form."
                        is_required: True
                        is_user_input: True
                outputs:
                    success: boolean
                    visitId: string
                    accountId: string
                    visitStatus: string
                    visitDate: string
                    assignedUser: string
                    summary: string
                    message: string

    subagent visit_activities:
        description: "Tracks assessment tasks, compliance audits, and delivery jobs."
        reasoning:
            instructions: ->
                | ===== ACTIVITIES RULES =====
                | 1. Assessment Tasks: When asked about tasks or audits, call {!@actions.get_tasks}.
                | 2. Job Status: When asked about retail execution status, call {!@actions.get_jobs}.
                | 3. Deliveries: When asked about shipments, call {!@actions.get_deliveries}.

            actions:
                get_tasks: @actions.fetch_assessment_tasks
                    description: "Fetch assessment activities and audits."
                    with actionType = "getActivities"
                    with visitId = @variables.visitId

                get_jobs: @actions.fetch_jobs_status
                    description: "Fetch job completion status."
                    with actionType = "getJobsStatus"
                    with visitId = @variables.visitId

                get_deliveries: @actions.fetch_deliveries
                    description: "Fetch delivery activities."
                    with actionType = "getDeliveryActivities"
                    with visitId = @variables.visitId

                return_to_intelligence: @utils.transition to @subagent.visit_intelligence
                    description: "Return to Visit Intelligence."

        actions:
            fetch_assessment_tasks:
                description: "Fetches assessment tasks for visit."
                target: "apex://Visit_Activity_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getActivities'."
                        is_required: True
                    visitId: string
                        description: "Target Visit ID."
                        is_required: True
                outputs:
                    summary: string
                    totalTasks: integer
                    completedTasks: integer
                    pendingTasks: integer
                    message: string

            fetch_jobs_status:
                description: "Fetches retail execution jobs status."
                target: "apex://Visit_Activity_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getJobsStatus'."
                        is_required: True
                    visitId: string
                        description: "Target Visit ID."
                        is_required: True
                outputs:
                    summary: string
                    message: string

            fetch_deliveries:
                description: "Fetches delivery activities for visit."
                target: "apex://Visit_Activity_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getDeliveryActivities'."
                        is_required: True
                    visitId: string
                        description: "Target Visit ID."
                        is_required: True
                outputs:
                    summary: string
                    message: string

    subagent forecasting_insights:
        description: "Predictive analytics for sales, demand, and inventory projections."
        reasoning:
            instructions: ->
                | ===== FORECASTING RULES =====
                | 1. Sales Projections: When asked for sales forecasts, call {!@actions.get_sales_projection}.
                | 2. Order Forecasts: When asked for order predictions, call {!@actions.get_order_projection}.
                | 3. Customer Forecasts: When asked for customer revenue trends, call {!@actions.get_customer_projection}.

            actions:
                get_sales_projection: @actions.forecast_sales
                    description: "Forecast sales revenue."
                    with actionType = "getSalesForecast"
                    with accountId = @variables.accountId

                get_order_projection: @actions.forecast_orders
                    description: "Forecast order demand."
                    with actionType = "getOrderForecast"
                    with accountId = @variables.accountId

                get_customer_projection: @actions.forecast_customers
                    description: "Forecast customer revenue growth."
                    with actionType = "getCustomerForecast"
                    with accountId = @variables.accountId

                return_to_intelligence: @utils.transition to @subagent.visit_intelligence
                    description: "Return to Visit Intelligence."

        actions:
            forecast_sales:
                description: "Calculates sales revenue forecast."
                target: "apex://Sales_Forecasting_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getSalesForecast'."
                        is_required: True
                    accountId: string
                        description: "Target Account ID."
                        is_required: True
                outputs:
                    summary: string
                    forecastSummary: string
                    confidenceLevel: string
                    reasoning: string
                    success: boolean

            forecast_orders:
                description: "Calculates order demand forecast."
                target: "apex://Sales_Forecasting_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getOrderForecast'."
                        is_required: True
                    accountId: string
                        description: "Target Account ID."
                        is_required: True
                outputs:
                    summary: string
                    forecastSummary: string
                    confidenceLevel: string
                    reasoning: string
                    success: boolean

            forecast_customers:
                description: "Calculates customer revenue growth forecast."
                target: "apex://Sales_Forecasting_Handler"
                inputs:
                    actionType: string
                        description: "Set to 'getCustomerForecast'."
                        is_required: True
                    accountId: string
                        description: "Target Account ID."
                        is_required: True
                outputs:
                    summary: string
                    forecastSummary: string
                    confidenceLevel: string
                    reasoning: string
                    success: boolean

    subagent ambiguous_question:
        description: "Handles ambiguous queries and guides the user."
        reasoning:
            instructions: ->
                | Provide friendly guidance asking the user if they would like to search visits, view account briefings, or create a new visit.
            actions:
                return_to_router: @utils.transition to @subagent.agent_router
                    description: "Return to main router."

    subagent clear_context:
        description: "Clears active session context variables."
        reasoning:
            instructions: ->
                | Clear all cached record IDs and return to main router.
            actions:
                reset_context: @utils.transition to @subagent.agent_router
                    description: "Reset context and return to router."
                    set @variables.visitId = ""
                    set @variables.accountId = ""
                    set @variables.accountName = ""
                    set @variables.visitStatus = ""
                    set @variables.visitDate = ""
                    set @variables.visitSummaryText = ""
