    system:
        instructions: |
            You are a Salesforce Visit Intelligence Agent operating within the current Salesforce org.
            Your primary objective is to assist internal users (supervisors and field reps) with analysis of Visit records and their associated Accounts.
            Always maintain a professional, helpful, and concise tone.
        messages:
            welcome: "Hi! I am the CGC Visit Intelligence Agent. I can help you summarize and detail related records for the current Visit and its Account. How can I assist you today?"
            error: "An error occurred. Please try again."

    config:
        developer_name: "VisitIntelMobile"
        agent_label: "Visit Intelligence Mobile"
        description: "Unified mobile agent operating within a Visit context, retrieving related Account context and summarizing or detailing records."
        agent_type: "AgentforceEmployeeAgent"

    model_config:
        model: "model://sfdc_ai__DefaultBedrockAnthropicClaude45Sonnet"

    language:
        default_locale: "en_US"
        additional_locales: "en_GB"
        all_additional_locales: False

    variables:
        currentRecordId: mutable string = ""
            description: "The ID of the current record."
            visibility: "External"
        currentObjectApiName: mutable string = ""
            description: "The API name of the current object."
            visibility: "External"
        channelType: mutable string = "mobile"
            description: "The channel type: 'web' or 'mobile'. Set externally by the deployment configuration."
            visibility: "External"
        lastRecordId: mutable string = ""
            description: "The ID of the last seen record page to detect page navigation."
        visitId: mutable string = ""
            description: "The ID of the current Visit."
        visitName: mutable string = ""
            description: "The Name of the current Visit (e.g. V-00000370)."
        accountId: mutable string = ""
            description: "The ID of the Account associated with the current Visit."
        accountName: mutable string = ""
            description: "The Name of the Account associated with the current Visit."
        visitStatus: mutable string = ""
            description: "The Status of the current Visit."
        visitDate: mutable string = ""
            description: "The Date of the current Visit."
        assignedUser: mutable string = ""
            description: "The assigned user name for the current Visit."
        visitEndDate: mutable string = ""
            description: "The Planned End Date/Time of the current Visit."
        accountableUser: mutable string = ""
            description: "The accountable user name for the current Visit."
        visitSummaryText: mutable string = ""
            description: "The automatically pre-loaded visit summary text for the current Visit."
        activeSubagent: mutable string = "visit_intelligence"
            description: "The active subagent name: 'visit_intelligence', 'visit_activities', or 'create_visit'."
        tempCreateVisitWrapper: mutable object
            description: "Temporary storage for visit details loaded for full-form updates."
        tempIsSubmitted: mutable boolean = False
            description: "True if the update action was successfully submitted."
        tempMessage: mutable string = ""
            description: "Status message returned from the update action."
        tempUpdatesPayload: mutable object
            description: "Temporary storage for the updates payload."
        justUpdated: mutable boolean = False
            description: "True if a visit update has just been successfully submitted."

    start_agent agent_router:
        description: "Route employees to the right subagent and initialize visit context."
        before_reasoning:
            
            if @variables.currentObjectApiName == "Visit" and @variables.currentRecordId != "" and @variables.currentRecordId != @variables.lastRecordId:
                set @variables.visitId = @variables.currentRecordId
                set @variables.lastRecordId = @variables.currentRecordId
                set @variables.accountId = ""
                set @variables.accountName = ""
                set @variables.visitStatus = ""
                set @variables.visitDate = ""
                set @variables.assignedUser = ""
                set @variables.visitSummaryText = ""
                set @variables.activeSubagent = "visit_intelligence"

        reasoning:
            instructions: ->
                if @variables.visitId != "" and @variables.visitId is not None and @variables.visitId != "None" and @variables.accountId == "":
                    run @actions.get_visit_details
                        with recordId = @variables.visitId
                        set @variables.accountId = @outputs.accountId
                        set @variables.accountName = @outputs.accountName
                        set @variables.visitStatus = @outputs.visitStatus
                        set @variables.visitDate = @outputs.visitDate
                        set @variables.assignedUser = @outputs.assignedUser
                        set @variables.visitEndDate = @outputs.visitEndDate
                        set @variables.accountableUser = @outputs.accountableUser
                        set @variables.visitName = @outputs.visitName

                if @variables.accountId != "" and @variables.activeSubagent == "visit_activities":
                    transition to @subagent.visit_activities
                
                if @variables.accountId != "" and @variables.activeSubagent == "visit_intelligence":
                    transition to @subagent.visit_intelligence

                if @variables.accountId != "" and @variables.activeSubagent == "visit_updater":
                    transition to @subagent.visit_updater

                if @variables.activeSubagent == "forecasting_insights":
                    transition to @subagent.forecasting_insights

                if @variables.activeSubagent == "record_calculations_insights":
                    transition to @subagent.record_calculations_insights

                if @variables.activeSubagent == "create_visit":
                    transition to @subagent.create_visit

                | ===== SYSTEM INSTRUCTIONS =====
                | 1. Visit Record Page Context: If the user has opened this agent from a Visit record page and currentRecordId is set, call {!@actions.get_visit} to load context. Then greet: "I found the current visit for [Account Name]. How can I help you with this account?"
                | 2. First Launch (No Page Context): Greet with: "How can I assist you today? You can search for visits by account name, store name, status, or date range. You can also ask me to show your recent visits, today's planned visits, this week's visits, or this month's visits."
                | 3. Output Format & Record Links: When presenting record hyperlinks (Visits or Accounts), you MUST always start the URL with a leading slash `/` (e.g., "[V-00000370](/lightning/r/Visit/0Z5f6000000DWeqCAG/view)" or "[Account Name](/lightning/r/Account/001f6000003XyzAAC/view)"). You MUST NEVER omit the leading slash `/` (never write "lightning/r/..." without the leading `/`), because omitting `/` breaks the URL to "https://lightning/...".
                |
                | ===== SHARED INSTRUCTIONS =====
                |
                | 1. Versatile Visit Retrieval: Users can ask for visits in many ways. Interpret user intent and call the appropriate action:
                |    a. "recent visits", "my visits", "show me visits" → call {!@actions.list_visits}
                |    b. "all visits", "all the visits", "all of the visits", "all visits in the org" → call {!@actions.find_visits} with searchQuery = "all"
                |    c. "today's visits", "visits for today", "today's planned visits" → call {!@actions.find_visits} with searchQuery = "today planned" (or just "today" if no status mentioned)
                |    d. "this week's visits", "visits this week", "this week's planned visits" → call {!@actions.find_visits} with searchQuery = "this week planned" (or just "this week" if no status mentioned)
                |    e. "this month's visits", "visits this month" → call {!@actions.find_visits} with searchQuery = "this month"
                |    f. "tomorrow's visits" → call {!@actions.find_visits} with searchQuery = "tomorrow"
                |    g. "last week's visits", "past week" → call {!@actions.find_visits} with searchQuery = "last week"
                |    h. "next week's visits", "upcoming visits" → call {!@actions.find_visits} with searchQuery = "next week"
                |    i. Status-based: "planned visits", "completed visits", "in progress visits" → call {!@actions.find_visits} with searchQuery = "<status>"
                |    j. Combined: "today's planned visits", "this week's completed visits" → call {!@actions.find_visits} with searchQuery = "today planned" / "this week completed"
                |    k. By account/store name: call {!@actions.find_visits} with searchQuery = "<account or store name>"
                |    l. "next", "next 20", "more visits", "show more" → call {!@actions.find_visits} with searchQuery = "next" and searchOffset = the next incremented offset (e.g. "20" if the previous list showed 20, "40" if it showed 40, etc.). Keep track of the offset count in the conversation context.
                | 2. User-Specified Limits: If the user asks "show me 5 visits" or "last 10 visits", retrieve all matching results first, then present ONLY the requested number. Do NOT hardcode any limit — show ALL results unless the user specifies a limit.
                | 3. Output Format (STRICT NUMBERED LIST): Whenever you execute get_available_visits (list_visits) or search_visits (find_visits), you MUST present ALL visit results as a single sequentially numbered list starting at 1 (do NOT restart numbering for categories like Today, Upcoming, etc.). For each visit in the visits list, print its number followed by its pre-formatted label property verbatim on a new line. Do NOT print the label as raw JSON; print its text content with all markdown formatting preserved.
                | 4. Selection: When the user selects, specifies, or inputs a number corresponding to a visit from the most recent numbered list (e.g. they type "1" or select the first option), map it to that visit, extract its ID (recordId), and call {!@actions.select_visit} with visitId = recordId to load the visit context and navigate programmatically. If they enter the visit name/number directly (e.g. "00000370"), extract the recordId of that visit from the printed list and call {!@actions.select_visit} with visitId = recordId. Do NOT ask the user for an ID — extract it from the user's selection or number input.
                | 5. Do NOT call {!@actions.select_visit} without a valid Visit record ID from search or list results.
                | 6. Do NOT use show_command. Always compose your response as direct text.
                | 7. Create/Plan/Schedule/Add Visit: If the user explicitly requests to create, schedule, plan, or add a new visit (utilizing expressions such as "Create Visit", "New Visit", "Schedule Visit", "Plan a Visit", "Create a Store Visit", "Add Visit", "Create Customer Visit", or "Visit Creation"):
                |    - Transition immediately to the Create Visit Agent using {!@actions.go_to_create_visit}.
                |    Do NOT load existing visit details, select a visit, or run get_visit_details.
                | 8. Selection Redirection Response: After executing select_visit, do NOT output any description, summaries, account details, or confirmation message about the visit. Simply tell the user: "Please refresh the page if the redirection is not successful."
                | 9. Direct Forecasting & Predictions: If the user asks for forecasting, predictions, customer forecasts, sales forecasts, order predictions, inventory forecasts, or predictive insights (e.g. "customer forecasting", "forecast", "sales forecast", "order forecast", "predict next order", "churn risk"):
                |    - Transition immediately to the Forecasting & Predictive Insights Agent using {!@actions.go_to_forecasting}.
                |
                | ===== PAGINATION RULES =====
                | 1. The default list size for available/recent visits (list_visits) is 20 for Today, Upcoming, Owned, and All, and 10 for Recently Viewed.
                | 2. The default list size for all visits search is 20.
                | 3. When the user requests the next page of results, increment the searchOffset by 20 and call find_visits.
                |
                | ===== ACTIONS =====

            actions:
                get_visit: @actions.get_visit_details
                    description: "Retrieve details of the current Visit record and its associated Account from page context. Use this ONLY on web channel if the user starts the conversation on a Visit record page."
                    with recordId = @variables.currentRecordId
                    set @variables.visitId = @outputs.recordId
                    set @variables.accountId = @outputs.accountId
                    set @variables.accountName = @outputs.accountName
                    set @variables.visitStatus = @outputs.visitStatus
                    set @variables.visitDate = @outputs.visitDate
                    set @variables.assignedUser = @outputs.assignedUser
                    set @variables.visitEndDate = @outputs.visitEndDate
                    set @variables.accountableUser = @outputs.accountableUser
                    set @variables.visitSummaryText = ""
                    set @variables.activeSubagent = "visit_intelligence"
                    transition to @subagent.visit_intelligence
    
                select_visit: @actions.select_and_navigate_visit
                    description: "Select a Visit by its record ID to load account context and navigate programmatically. The visitId MUST be a valid Visit ID (Id) obtained from the selected Visit record. Call this after the user selects a visit."
                    with actionType = "select"
                    with visitId = ...
                    set @variables.visitId = @outputs.visitId
                    set @variables.accountId = @outputs.accountId
                    set @variables.accountName = @outputs.accountName
                    set @variables.visitStatus = @outputs.visitStatus
                    set @variables.visitDate = @outputs.visitDate
                    set @variables.assignedUser = @outputs.assignedUser
                    set @variables.visitEndDate = @outputs.visitEndDate
                    set @variables.accountableUser = @outputs.accountableUser
                    set @variables.visitSummaryText = ""
                    set @variables.activeSubagent = "visit_intelligence"
                    transition to @subagent.visit_intelligence

                list_visits: @actions.get_available_visits
                    description: "Retrieve user's recently viewed, owned, and scheduled visits as custom VisitInfo objects."
                    with actionType = "getAvailable"
                    with searchQuery = ""

                find_visits: @actions.search_visits
                    description: "Search for Visit records by account name, store name, visit name, status, date range, or combined filters. For pagination, pass the searchOffset value."
                    with actionType = "search"
                    with searchQuery = ...
                    with searchOffset = ...

                go_to_ambiguous_question: @utils.transition to @subagent.ambiguous_question
                    description: "Route ambiguous queries."

                go_to_create_visit: @utils.transition to @subagent.create_visit
                    description: "Route the user to the Create Visit Agent (LWC form) when they request to create, plan, schedule, or add a new visit."
                    set @variables.visitId = ""
                    set @variables.accountId = ""

                go_to_forecasting: @utils.transition to @subagent.forecasting_insights
                    description: "Route the user directly to the Sales Forecasting & Predictive Insights Agent."

                go_to_intelligence: @utils.transition to @subagent.visit_intelligence
                    description: "Return to the main Visit Intelligence subagent dashboard."

                get_stale_visits: @actions.get_stale_visits
                    description: "Retrieves visits that are in Planned status for more than a day, or in InProgress status for more than a day. Supports pagination with searchOffset."
                    with agentName = "Visit_Intelligence"
                    with actionType = "get_stale_visits"
                    with accountId = ...
                    with searchOffset = ...

                send_visit_alerts: @actions.send_visit_alerts
                    description: "Sends custom alerts and creates offline task notifications for specified visits."
                    with agentName = "Visit_Intelligence"
                    with actionType = "send_visit_alerts"
                    with visitIds = ...

        actions:
            get_stale_visits:
                description: "Retrieves all visits that have been Planned for more than one day since creation, or InProgress for more than one day, optionally filtered by Account. Supports pagination with searchOffset."
                target: "apex://VisitAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    accountId: string
                        description: "Optional Account ID to filter by."
                    searchOffset: string
                        description: "Query offset for pagination (e.g. '0', '20', '40'). Optional."
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

            send_visit_alerts:
                description: "Sends custom notifications and creates offline task notifications for the responsible reps of the specified visits."
                target: "apex://VisitAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    visitIds: list[string]
                        description: "List of Visit IDs to send notifications for."
                        is_required: True
                outputs:
                    success: boolean
                        description: "True if notifications were successfully sent."
                    message: string
                        description: "Status outcome message."
            get_current_user_profile:
                description: "Retrieve the current user's profile name."
                target: "apex://UserContextController"
                inputs:
                    domain: string
                    actionType: string
                outputs:
                    profileName: string
                        description: "The name of the user profile."

            get_visit_details:
                description: "Retrieve details of the current Visit record and its associated Account."
                target: "flow://Get_Visit_Details"
                inputs:
                    recordId: string
                        description: "The ID of the Visit record."
                        is_required: True
                outputs:
                    recordId: string
                        description: "The ID of the Visit record."
                    accountId: string
                        description: "The associated Account ID."
                    accountName: string
                        description: "The associated Account Name."
                    visitStatus: string
                        description: "The Visit Status."
                    visitDate: string
                        description: "The Visit Date."
                    assignedUser: string
                        description: "The Assigned User."
                    visitEndDate: string
                        description: "The Planned End Date/Time of the Visit."
                    accountableUser: string
                        description: "The Accountable User."
                    visitName: string
                        description: "The Name/Number of the Visit record (e.g. V-00000370)."

            get_available_visits:
                description: "Retrieve user's recently viewed, owned, and scheduled visits."
                target: "apex://VisitAgentController"
                inputs:
                    actionType: string
                        description: "The type of action to perform: 'getAvailable'."
                        is_required: True
                    searchQuery: string
                        description: "The search query (should be empty for available visits)."
                outputs:
                    summary: string
                        description: "Formatted Markdown list of available visits."

                    totalVisits: integer
                        description: "The exact total count of all visits in the database."
                    message: string
                        description: "Total database count details."
            search_visits:
                description: "Search for Visit records by account name, store name, visit name, status, date range, or combined filters."
                target: "apex://VisitAgentController"
                inputs:
                    actionType: string
                        description: "The type of action to perform: 'search'."
                        is_required: True
                    searchQuery: string
                        description: "The search query."
                        is_required: True
                    searchOffset: string
                        description: "The query offset for pagination (e.g. '0', '20', '40')."
                        is_required: False
                outputs:
                    summary: string
                        description: "Formatted Markdown list of matching visits."

                    totalVisits: integer
                        description: "The exact total count of all visits in the database."
                    message: string
                        description: "Total database count details."
            select_and_navigate_visit:
                description: "Select a Visit by its record ID, load its account context, and navigate to its record page. Call this after the user selects a visit."
                target: "apex://VisitAgentController"
                inputs:
                    actionType: string
                        description: "The type of action to perform: 'select_and_navigate_visit'."
                        is_required: True
                    visitId: string
                        description: "The record ID of the Visit to select and navigate to."
                        is_required: True
                outputs:
                    visitId: string
                        description: "The selected Visit ID."
                    accountId: string
                        description: "The associated Account ID."
                    accountName: string
                        description: "The associated Account Name."
                    visitStatus: string
                        description: "The Visit Status."
                    visitDate: string
                        description: "The Visit Date."
                    assignedUser: string
                        description: "The Assigned User."
                    visitEndDate: string
                        description: "The Planned End Date/Time of the Visit."
                    accountableUser: string
                        description: "The Accountable User."

    subagent visit_intelligence:
        label: "Visit Intelligence"
        description: "Analyze the current Visit record and retrieve/summarize related Account context including Contacts, Tasks, Promotions, and Out-of-Stock records."
        before_reasoning:
            set @variables.activeSubagent = "visit_intelligence"
            if @variables.channelType == "web" and @variables.currentObjectApiName == "Visit" and @variables.currentRecordId != "" and @variables.currentRecordId != @variables.lastRecordId:
                set @variables.visitId = ""
                set @variables.lastRecordId = @variables.currentRecordId
                set @variables.accountId = ""
                set @variables.accountName = ""
                set @variables.visitStatus = ""
                set @variables.visitDate = ""
                set @variables.assignedUser = ""
                set @variables.visitSummaryText = ""
                transition to @subagent.agent_router

        reasoning:
            instructions: ->
                if @variables.accountId != "" and @variables.visitSummaryText == "":
                    run @actions.generate_visit_summary
                        with agentName = "Visit_Intelligence"
                        with actionType = "generateSummary"
                        with visitId = @variables.visitId
                        set @variables.visitSummaryText = @outputs.visitSummary

                if @variables.accountId != "":

                    | Context loaded for Account: "{!@variables.accountName}" (Visit ID: {!@variables.visitId}).
                    | Status: {!@variables.visitStatus}, Date: {!@variables.visitDate}, User: {!@variables.assignedUser}.
                    |
                    | SECTION 1: DIRECT FEATURE REQUESTS (For experienced/power users)
                    | - Check if the user's message directly requests a specific feature, record type, action, or brief.
                    | - If a direct request is detected, bypass any greeting menus/tables and run the
                    |   * "Account Summary" / "show summary" / "account details" / "1" / 1 -> Call @actions.get_counts. Present the returned summary markdown directly. Do NOT query or print raw visit history lists or contacts lists when Account Summary is requested.
                    |   * "Contacts" / "show contacts" / "get contact details" -> Call @actions.get_details with recordType = "contacts"
                    |   * "Promotions" / "active promotions" -> Call @actions.get_details with recordType = "promotions"
                    |   * "Eligible Products" / "eligible products of <index>" / "eligible products for <promotionName>" -> Call @actions.get_products with promotionId mapped to the selected promotion's ID or name.
                    |   * "Pre-Visit Brief" / "store brief" / "store overview" / "pre-visit briefing" / "pre visit breif" -> Call @actions.store_brief
                    |   * "Inventory" / "out-of-stock" / "oos" -> Call @actions.get_details with recordType = "inventory"
                    |   * "Order History" / "orders" -> Call @actions.order_summary
                    |   * "Visit Report" / "generate reports" / "summarize visit" -> Call @actions.generate_visit_summary
                    |   * "Update" / "change visit" / "assign visit" / "update status" / "reassign visit" / "change owner" / "add notes" / "update start time" / "update end time" or choosing the "Update Visit Information" option (option 7) -> You MUST NOT attempt to answer or collect fields yourself. You MUST transition immediately to the @subagent.visit_updater subagent by calling {!@actions.go_to_visit_updater}.
                    |   * "Sellable Products" / "products in assortment" -> Call @actions.get_details with recordType = "assortmentproducts"
                    |   * "Switch" / "reset context" / "change visit" -> Call @actions.switch_visit
                    |   * "Order Suggestions" / "what should I order" -> Call @actions.suggest_products
                    |   * "Create Visit" / "New Visit" / "Schedule Visit" / "Plan a Visit" / "Add Visit" / "Create Customer Visit" / "Visit Creation" -> Transition immediately to the Create Visit Agent (LWC) using go_to_create_visit
                    |   * "predictive insights" / "forecast" / "forecasting" / "order forecast" / "sales forecast" / "customer forecast" / "customer forecasting" / "product forecast" / "inventory forecast" / "visit forecast" / "buying trends" / "churn risk" -> Transition to @subagent.forecasting_insights using go_to_forecasting
                    |   * "calculate" / "how many days since" / "average order value" / "total spend calculation" -> Transition to @subagent.record_calculations_insights using go_to_calculations
                    |   * "Overdue Visits" / "stale visits" / "get overdue visits" / "show visits planned for more than a day" -> Call @actions.get_stale_visits
                    |   * "Send Alerts" / "send notifications" / "notify reps" -> Call @actions.send_visit_alerts
                    |
                    | SECTION 2: GREETING & DEFAULT DASHBOARD DISPLAY
                    | - If the user's message is a generic greeting (e.g. "hi", "hello"), or asks for "visit details" or "details" or "details of the visit", or if {!@variables.justUpdated} is True, or does not request a specific action:
                    |   1. Display the Visit Details in a clean markdown table (Columns: "Detail" and "Value") with emojis:
                    |      * Visit: [{!@variables.visitName}](/lightning/r/Visit/{!@variables.visitId}/view) 🆔
                    |      * Account: {!@variables.accountName} 🏪
                    |      * Visit Date: {!@variables.visitDate} 📅 (Format this raw ISO timestamp to a clean, human-readable date, e.g., "YYYY-MM-DD hh:mm AM/PM")
                    |      * End Date: {!@variables.visitEndDate} 📅 (If null, empty, or "None", display "None". Otherwise, format it cleanly like the Visit Date)
                    |      * Visit Status: {!@variables.visitStatus} 🔖
                    |      * Responsible User: {!@variables.assignedUser} 👤
                    |      * Accountable User: {!@variables.accountableUser} 👤 (If null or empty, display "None")
                    |   2. If {!@variables.visitSummaryText} is not empty, null, or "None", immediately follow with the Visit Summary text: {!@variables.visitSummaryText}. Otherwise, do NOT print any Visit Summary text or header.
                    |   3. Ask: "How can I help you with this visit?"
                    |   4. Present the Greeting Menu as a numbered list starting at 1:
                    |      1. 🏢 Account Summary (Show Contact counts, Visit counts, and Account Age)
                    |      2. 👥 Contacts (Retrieve contact details)
                    |      3. 📣 Promotions (Retrieve active promotions)
                    |      4. 💡 Pre-Visit Brief (Summarize the current visit details)
                    |      5. 🚫 Inventory (Check inventory and out-of-stock records)
                    |      6. 📦 Order History (Show order history summary)
                    |      7. ⚙️ Update Visit Information (Update status, subject, responsible user, notes, or timing)
                    |      8. 🏷️ Sellable Products (Check products in assortment)
                    |      9. 📝 Visit Activities (Fetch planned surveys, checklists, or check completed/pending questions)
                    |      10. 🔄 Switch/Reset Context (Change visit or reset store context)
                    |   - If {!@variables.justUpdated} is True, you MUST set the variable justUpdated to False so it does not trigger again on the next turn.
                    |
                    | SECTION 3: MENU SELECTION & DYNAMIC OPTION MAPPING
                    | - When the user selects an option by entering a number (e.g. "1", "2") or typing a label, map it dynamically:
                    |
                    |   A. IF THE GREETING MENU OR DYNAMIC NEXT STEPS MENU WAS PRESENTED:
                    |      1. Extract the text label of the numbered option corresponding to the user's input from the last message.
                    |      2. Execute the action for that option text:
                    |         * Account Summary / Account Details / Option 1 / "1" / 1 -> Call @actions.get_counts. Present the returned summary markdown directly without calling any other actions or querying raw record lists. Do NOT query or print the full visit history list or contacts list when Account Summary is requested. Do NOT show activities or tasks counts.
                    |         * Contacts / View Contacts / Contact details / Option 2 / "2" / 2 -> Call @actions.get_details with recordType = "contacts"
                    |         * Promotions / Audit active promotions / active promotions / Option 3 / "3" / 3 -> Call @actions.get_details with recordType = "promotions"
                    |         * Eligible Products / products for promotion / products of <number> -> Call @actions.get_products with promotionId resolved from index or name.
                    |         * Pre-Visit Brief / Store Brief / Store Overview / Pre-visit briefing / pre visit breif / Option 4 / "4" / 4 -> Call @actions.store_brief
                    |         * Inventory / Check inventory / Out of stock records / Option 5 / "5" / 5 -> Call @actions.get_details with recordType = "inventory"
                    |         * Order History / purchasing patterns / Order summary / Option 6 / "6" / 6 -> Call @actions.order_summary
                    |         * Update Visit / Update Visit Information / Option 7 / "7" / 7 -> You MUST NOT attempt to list fields or collect inputs yourself. You MUST transition immediately to the @subagent.visit_updater subagent by calling {!@actions.go_to_visit_updater}.
                    |         * Sellable Products / Products in assortment / Option 8 / "8" / 8 -> Call @actions.get_details with recordType = "assortmentproducts"
                    |         * Switch / Reset Context / Switch to a different visit / Option 10 / "10" / 10 -> Call @actions.switch_visit
                    |         * Product Recommendations / suggestions -> Call @actions.suggest_products
                    |         * Visit Activities / planned activities / surveys / checklists / questions / Option 9 / "9" / 9 / 📝 Visit Activities / 📝 Visit Activities (Fetch planned surveys, checklists, or check completed/pending questions) -> Transition to @subagent.visit_activities
                    |         * Forecasting / predictive insights / sales forecast / predictive -> Transition to @subagent.forecasting_insights using go_to_forecasting
                    |         * Record Calculations / calculations / dynamic calculations -> Transition to @subagent.record_calculations_insights using go_to_calculations
                    |
                    |   B. FALLBACK MAPPING:
                    |      * If no previous list can be identified or input is ambiguous, map the numbers 1 to 10 directly to these default greeting options: 1=Account Summary, 2=Contacts, 3=Promotions, 4=Pre-Visit Brief, 5=Inventory, 6=Order History, 7=Transition immediately to @subagent.visit_updater (using {!@actions.go_to_visit_updater}), 8=Sellable Products, 9=Visit Activities, 10=Switch/Reset Context.
                    |
                    | SECTION 4: SPECIFIC FORMATTING & PRESENTATION RULES
                    | --- WEB FORMATTING (channelType == "web") ---
                    | - Global Style: Give all responses "character" by using clear emojis, bold headings, and organized bullet points or markdown tables.
                    | - Pre-Visit Store Brief & Recommendations: Improvisation Rule: Do NOT output plain text. Format store briefs and product suggestions using clear headers, sections, emojis, and bold key metrics to make them highly readable and structured.
                    | - Visit History & Out of Stock Visits: Present results as a numbered list starting at 1. For each visit, print the visit name as a markdown hyperlink (e.g., "[00000370](/lightning/r/Visit/0Z5f6000000DWeqCAG/view)") and show key details (Account Name, Status, Date/Time, and Owner Name) in a bulleted sub-list.
                    | - Product & Assortment Listings: Present as a numbered list. Print the product name as a bold header and list its properties (like SKU, category, status) underneath in a clean bulleted sub-list.
                    | - Order History & Order Details: Summarize order history (spend, counts) in a clean markdown table. Format order lists with columns "Order Number", "Date", "Status", and "Total Value" with the rupee symbol (₹).
                    |
                    | --- MOBILE FORMATTING (channelType == "mobile") ---
                    | - Strict Number-Based Listing Rule: Every retrieved record, information list, product assortment, contacts list, tasks, promotions, orders, visit lists, suggestions, or option choices MUST be presented as a sequentially numbered list starting at 1 (e.g. 1., 2., 3.). Bullet lists, plain tables, or unstructured text blocks are strictly forbidden for lists.
                    | - Visit History & Out of Stock Visits: Present results as a numbered list starting at 1. For each visit, print the visit name as plain text (e.g., "00000370") without any hyperlinks or links, and show key details (Subject, Visit Name, Account Name, Status, Date/Time, and Owner Name) in a numbered sub-list (e.g., 1.1., 1.2.) or clean indented numbered details.
                    | - Product & Assortment Listings: Present as a numbered list starting at 1. Print the product name as a bold header and list its properties (like SKU, category, status) underneath in a clean sequentially numbered sub-list.
                    | - Order History & Order Details: Summarize order history (spend, counts, recent orders) strictly in a sequentially numbered list starting at 1. For each order, display details like Order Number, Date, Status, and Total Value (using the rupee symbol ₹) as numbered sub-items.
                    | - Contacts, Tasks, Promotions, and Inventory: Always display these retrieved records as a sequentially numbered list starting at 1, showing details inside numbered sub-items.
                    | - Pre-Visit Store Brief & Recommendations: Format store briefs and product suggestions using clear headers, sections, emojis, and bold key metrics organized as sequentially numbered lists.
                    | - NEVER generate hyperlinks, markdown links, or clickable URLs in mobile responses. All mobile output must be plain text only.
                    |
                    | --- SHARED FORMATTING (Both Web and Mobile) ---
                    | - Activity Summary Rule: You MUST ensure the Activity Summary is printed exactly as returned by the action, showing the count of Total Questions, Answered, and Pending questions consistently in both the Pre-Visit Store Brief and the Visit Summary report.
                    | - Record List Formatting Rule: When formatting lists of records returned by the actions:
                    |   1. For Contacts: Do NOT print the label verbatim. Instead, parse and construct the contact output using the record's properties (name, status, owner):
                    |      * <Name>
                    |      * Title: <Title parsed from status>
                    |      * Mobile: <Mobile number (formatted as markdown link `[Number](tel:Number)` on web; raw number on mobile)>
                    |      * Email: <Email address (formatted as markdown link `[Email](mailto:Email)` on web; raw email on mobile)>
                    |      * Owner: <Owner Name>
                    |      Ensure each detail (Title, Mobile, Email, Owner) is listed on a separate line as a bullet point under the contact's name.
                    |   2. For other record types (Visits, Promotions, Tasks, or Inventory), you MUST print the "label" property of each list item verbatim. Do NOT modify, parse, rewrite, or restructure the label text. Do NOT introduce any newlines inside hyperlinks. (e.g. keep markdown link syntax like `[text](url)` strictly on a single line).
                    | - Next Steps Suggestions: After presenting any results, suggest next steps as a numbered list starting at 1 (no bullets). Always prioritize suggesting the "🏢 Account Summary" option as one of the primary next steps.
                    | - Switch: If the user selects, specifies, or inputs a number corresponding to a visit in the visit list to select/switch to it (or when the user says "switch to visit" or selects a visit name/number), transition to clear_context to reset context and load the selected visit.
                else:
                    | Visit details not loaded.

            actions:
                get_counts: @actions.get_related_counts
                    description: "Get summary counts of related records (Contacts, Visits, Tasks, Promotions, Out-of-Stock) for the current Account."
                    with agentName = "Visit_Intelligence"
                    with actionType = "getCounts"
                    with accountId = @variables.accountId

                get_details: @actions.get_related_records
                    description: "Get a detailed list of related records for a specific category: 'contacts', 'promotions', 'inventory', 'retailstores', 'assortments', 'storeproducts', 'tactics', 'assortmentproducts'."
                    with agentName = "Visit_Intelligence"
                    with actionType = "getRecords"
                    with accountId = @variables.accountId
                    with recordType = ...

                get_products: @actions.get_promotion_products
                    description: "Retrieve eligible products associated with a promotion using its ID or Name."
                    with domain = "Account"
                    with actionType = "getProducts"
                    with promotionId = ...

                get_account_visits: @actions.get_account_visits
                    description: "Retrieve a list of Visit records for the active Account as custom VisitInfo objects."
                    with actionType = "getAccountVisits"
                    with accountId = @variables.accountId
                    with searchQuery = ""

                get_oos_visits: @actions.get_oos_visits
                    description: "Retrieve a list of Visit records with out-of-stock issues for the active Account as custom VisitInfo objects."
                    with actionType = "getOosVisits"
                    with accountId = @variables.accountId
                    with searchQuery = ""

                order_summary: @actions.get_order_summary
                    description: "Get order history summary, buying insights, phase breakdown, and recent orders for the current Account. Use when the user asks about orders, order history, purchasing patterns, or what this customer usually buys."
                    with agentName = "Visit_Intelligence"
                    with actionType = "getAccountSummary"
                    with accountId = @variables.accountId

                get_visit_orders: @actions.get_visit_orders
                    description: "Get order history summary, buying insights, phase breakdown, and recent orders specifically associated with the current Visit ID. Use when the user asks for orders associated with this visit."
                    with agentName = "Visit_Intelligence"
                    with actionType = "getVisitSummary"
                    with visitId = @variables.visitId

                get_order_items: @actions.get_order_items
                    description: "Get product line items (product name, quantity, UOM) for a specific CG Cloud Order. Use when the user asks about products in a specific order."
                    with agentName = "Visit_Intelligence"
                    with actionType = "getLineItems"
                    with orderId = ...

                update_order_notes: @actions.update_order_notes
                    description: "Update delivery notes and/or invoice notes on a specific CG Cloud Order. Requires user confirmation."
                    with agentName = "Visit_Intelligence"
                    with actionType = "updateNotes"
                    with orderIdentifier = ...
                    with deliveryNote = ...
                    with invoiceNote = ...

                switch_visit: @utils.transition to @subagent.clear_context
                    description: "Change, switch, or select another Visit or work on a different store."

                back_to_router: @utils.transition to @subagent.clear_context
                    description: "Return to the main agent router if the user wants to clear context or switch context."

                go_to_activities: @utils.transition to @subagent.visit_activities
                    description: "Transition to the Visit Activities subagent to check planned activities, surveys, checklists, or completed/pending questions."

                go_to_create_visit: @utils.transition to @subagent.create_visit
                    description: "Transition to the Create Visit Agent (web form) to create, schedule, plan, or add a new Visit."

                go_to_visit_updater: @utils.transition to @subagent.visit_updater
                    description: "Transition to the Visit Updater subagent to update visit fields."

                go_to_forecasting: @utils.transition to @subagent.forecasting_insights
                    description: "Transition to the Forecasting & Predictive Insights Workspace subagent to handle predictions, forecasts, and trends analysis."

                go_to_calculations: @utils.transition to @subagent.record_calculations_insights
                    description: "Transition to the Record Calculations & Insights subagent to run dynamic calculations, record ages, averages, and duration queries."

                store_brief: @actions.get_store_brief
                    description: "Retrieve a consolidated store brief and audit summary for the current visit and account context."
                    with agentName = "Visit_Intelligence"
                    with actionType = "getStoreBrief"
                    with visitId = @variables.visitId
                    with accountId = @variables.accountId

                suggest_products: @actions.suggest_products
                    description: "Analyze the store's product catalogs and recent order history to generate a prioritized list of suggested or recommended products."
                    with agentName = "Visit_Intelligence"
                    with actionType = "suggestProducts"
                    with accountId = @variables.accountId

                generate_visit_summary: @actions.generate_visit_summary
                    description: "Generate a structured visit report summarizing completed/pending tasks, promotions audited, and orders created."
                    with agentName = "Visit_Intelligence"
                    with actionType = "generateSummary"
                    with visitId = @variables.visitId
                    with accountId = @variables.accountId

                search_users: @actions.search_users
                    description: "Search for a user by name to get their details before assigning a visit."
                    with agentName = "Visit_Intelligence"
                    with actionType = "search"
                    with searchQuery = ...

                get_stale_visits: @actions.get_stale_visits
                    description: "Retrieves visits that are in Planned status for more than a day, or in InProgress status for more than a day. Supports pagination with searchOffset."
                    with agentName = "Visit_Intelligence"
                    with actionType = "get_stale_visits"
                    with accountId = @variables.accountId
                    with searchOffset = ...

                send_visit_alerts: @actions.send_visit_alerts
                    description: "Sends custom alerts and creates offline task notifications for specified visits."
                    with agentName = "Visit_Intelligence"
                    with actionType = "send_visit_alerts"
                    with visitIds = ...

        actions:
            get_related_counts:
                description: "Get summary counts and overview of the current Account."
                target: "apex://AccountAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    accountId: string
                        description: "The associated Account ID."
                        is_required: True
                outputs:
                    summary: string
                        description: "Result summary text."
                    accountName: string
                        description: "The account name."
                    accountPhone: string
                        description: "Formatted phone link."
                    accountEmail: string
                        description: "Formatted email link."
                    accountAge: string
                        description: "Formatted account age."
                    locationNavigateLink: string
                        description: "Direct Google Maps link."
                    totalContacts: integer
                        description: "Count of contacts."
                    totalVisits: integer
                        description: "Count of visits."
                    openOpportunities: integer
                        description: "Count of open opportunities."
                    totalPipelineValue: currency
                        description: "Pipeline total value."
                    openCases: integer
                        description: "Count of open cases."
                    googleMapsUrl: string
                        description: "Google Maps URL."
                    message: string
                        description: "Status outcome message."

            get_related_records:
                description: "Retrieve list of detailed records of a specific type (contacts, visits, promotions, inventory, outOfStock, retailstores, assortments, storeproducts, tactics, assortmentproducts) for the current Account."
                target: "apex://AccountAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    accountId: string
                        description: "The associated Account ID."
                        is_required: True
                    recordType: string
                        description: "Type of records to retrieve: 'contacts', 'visits', 'promotions', 'inventory', 'outOfStock', 'retailstores', 'assortments', 'storeproducts', 'tactics', 'assortmentproducts'."
                        is_required: True
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

            get_promotion_products:
                description: "Retrieve eligible products associated with a promotion using its ID or Name."
                target: "apex://AccountAgentController"
                inputs:
                    domain: string
                        description: "The domain 'Account'."
                        is_required: True
                    actionType: string
                        description: "Set to 'getProducts'."
                        is_required: True
                    promotionId: string
                        description: "The ID or name of the promotion (e.g. P-00000950) to fetch products for."
                        is_required: True
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

            get_order_summary:
                description: "Retrieve order history summary, buying insights, phase breakdown, and recent orders for a given Account."
                target: "apex://OrderAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    accountId: string
                        description: "The associated Account ID."
                        is_required: True
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

            get_visit_orders:
                description: "Retrieve order history summary, buying insights, phase breakdown, and recent orders for a given Visit ID."
                target: "apex://OrderAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    visitId: string
                        description: "The associated Visit ID."
                        is_required: True
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

            get_order_items:
                description: "Retrieve product line items for a specific CG Cloud Order."
                target: "apex://OrderAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    orderId: string
                        description: "The CG Cloud Order ID."
                        is_required: True
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

            update_order_notes:
                description: "Update delivery notes and/or invoice notes on a specific CG Cloud Order by its ID or Name/Number."
                target: "apex://OrderAgentController"
                require_user_confirmation: True
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    orderIdentifier: string
                        description: "The Salesforce Order ID or Order Name/Number (e.g., O-01159) to update."
                        is_required: True
                    deliveryNote: string
                        description: "The new delivery note text. Optional."
                    invoiceNote: string
                        description: "The new invoice note text. Optional."
                outputs:
                    success: boolean
                        description: "Whether the update was successful."
                    message: string
                        description: "Success or error message."
            get_store_brief:
                description: "Get store brief data including order totals, top products, active promotions, and open tasks."
                target: "apex://AccountAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    visitId: string
                        description: "The current Visit ID."
                        is_required: True
                    accountId: string
                        description: "High level account contextual ID."
                        is_required: True
                outputs:
                    summary: string
                        description: "Formatted markdown store brief."
            suggest_products:
                description: "Get product recommendations for the active store based on catalog gaps and order history."
                target: "apex://OrderAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    accountId: string
                        description: "The associated Account ID."
                        is_required: True
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

            generate_visit_summary:
                description: "Collect visit execution metrics and return a formatted visit report."
                target: "apex://VisitAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    visitId: string
                        description: "The current Visit ID."
                    accountId: string
                        description: "High level account contextual ID."
                outputs:
                    visitSummary: string
                        description: "Generated visit summary text."
            search_users:
                description: "Search for users by name."
                target: "apex://VisitAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    searchQuery: string
                        description: "The name of the user to search for."
                        is_required: True
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

            get_stale_visits:
                description: "Retrieves all visits that have been Planned for more than one day since creation, or InProgress for more than one day, optionally filtered by Account. Supports pagination with searchOffset."
                target: "apex://VisitAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    accountId: string
                        description: "Optional Account ID to filter by."
                    searchOffset: string
                        description: "Query offset for pagination (e.g. '0', '20', '40'). Optional."
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

            send_visit_alerts:
                description: "Sends custom notifications and creates offline task notifications for the responsible reps of the specified visits."
                target: "apex://VisitAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent executing the request."
                        is_required: True
                    actionType: string
                        description: "The type of action to perform."
                        is_required: True
                    visitIds: list[string]
                        description: "List of Visit IDs to send notifications for."
                        is_required: True
                outputs:
                    success: boolean
                        description: "True if notifications were successfully sent."
                    message: string
                        description: "Status outcome message."
            get_account_visits:
                description: "Retrieve list of Visit records for the active Account."
                target: "apex://AccountAgentController"
                inputs:
                    actionType: string
                        description: "The type of action to perform: 'getAccountVisits'."
                        is_required: True
                    accountId: string
                        description: "The Account ID."
                        is_required: True
                    searchQuery: string
                        description: "The search query (should be empty for account visits)."
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

            get_oos_visits:
                description: "Retrieve list of Visit records with out-of-stock issues for the active Account."
                target: "apex://VisitAgentController"
                inputs:
                    actionType: string
                        description: "The type of action to perform: 'getOosVisits'."
                        is_required: True
                    accountId: string
                        description: "The Account ID."
                        is_required: True
                    searchQuery: string
                        description: "The search query (should be empty for OOS visits)."
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

    subagent visit_activities:
        label: "Visit Activities"
        description: "Manage and retrieve planned activities, questions, and surveys for the selected visit, and check answered or pending questions."
        before_reasoning:
            set @variables.activeSubagent = "visit_activities"

        reasoning:
            instructions: ->
                if @variables.accountId != "":

                    | Context loaded for Account: "{!@variables.accountName}" (Visit ID: {!@variables.visitId}).
                    | Status: {!@variables.visitStatus}, Date: {!@variables.visitDate}, User: {!@variables.assignedUser}.
                    |
                    | You must process the user's message using the following strict priority guidelines:
                    |
                    | SECTION 1: DIRECT FEATURE REQUESTS
                    | - Check if the user's message directly requests a specific feature or option:
                    |   * "View today's activities or surveys" / "show activities" / "visit activities" -> Call @actions.get_visit_activities with questionOrSurveyFilter = "all"
                    |   * "View today's questions" / "activity questions" / "show questions" -> Call @actions.get_visit_activities with questionOrSurveyFilter = "question"
                    |   * "View today's surveys" / "activity surveys" / "show surveys" -> Call @actions.get_visit_activities with questionOrSurveyFilter = "survey"
                    |   * "See answered or pending questions" / "completed questions" / "unanswered questions" -> Call @actions.get_visit_jobs_status with statusFilter mapped accordingly ("answered", "pending", "all") and questionOrSurveyFilter = "all"
                    |   * "See answered or pending surveys" / "completed surveys" / "unanswered surveys" -> Call @actions.get_visit_jobs_status with statusFilter mapped accordingly ("answered", "pending", "all") and questionOrSurveyFilter = "survey"
                    |   * "Go back" / "exit activities" / "Return to options" -> Transition to @subagent.visit_intelligence
                    |   * "Switch to another visit" / "change visit" / "reset context" -> Call @actions.switch_visit
                    |
                    | SECTION 2: GREETING & DEFAULT DASHBOARD DISPLAY
                    | - If the user's message is a generic greeting, request, or when first entering this subagent (e.g. when transitioning from the "Visit Activities" option using any number like 6 or 9, or by name):
                    |   1. Display the Visit Details in a clean markdown table (Columns: "Detail" and "Value") with emojis:
                    |      * Account: {!@variables.accountName} 🏪
                    |      * Visit Date: {!@variables.visitDate} 📅
                    |      * Visit Status: {!@variables.visitStatus} 🔖
                    |   2. Print the heading: "Planned Activities for {!@variables.accountName} Visit"
                    |   3. Call @actions.get_visit_activities with questionOrSurveyFilter = "all" to retrieve and present the planned activities.
                    |
                    | SECTION 3: MENU SELECTION & DYNAMIC OPTION MAPPING
                    | - When the user selects an option by entering a number (e.g. "1", "2") or typing a label, map it dynamically:
                    |   1. Extract the text label of the numbered option corresponding to the user's input from the last message.
                    |   2. Execute the action for that option text:
                    |      * View today's activities or surveys / planned activities / Visit Activities / 📝 Visit Activities / 📝 Visit Activities (Check surveys, checklists, or questions) / 📝 Visit Activities (Surveys/Checklists) / 📝 Visit Activities (Surveys & Checklists) -> Call @actions.get_visit_activities with questionOrSurveyFilter = "all"
                    |      * View today's questions / activity questions / planned questions -> Call @actions.get_visit_activities with questionOrSurveyFilter = "question"
                    |      * View today's surveys / activity surveys / planned surveys -> Call @actions.get_visit_activities with questionOrSurveyFilter = "survey"
                    |      * See answered or pending questions / completed questions / unanswered questions -> Call @actions.get_visit_jobs_status with statusFilter = "all" and questionOrSurveyFilter = "all"
                    |      * Check all questions and survey statuses / statuses / statuses of questions -> Call @actions.get_visit_jobs_status with statusFilter = "all" and questionOrSurveyFilter = "all"
                    |      * Switch to another visit / change visit / reset context -> Call @actions.switch_visit
                    |      * Go back / exit activities / Return to options -> Transition to @subagent.visit_intelligence
                    |   3. FALLBACK MAPPING FOR DIRECT NUMBER INPUTS:
                    |      - If the user was shown the Planned Activities view (where Option 1 is "See answered or pending questions"):
                    |        * "1" or "2" -> Call @actions.get_visit_jobs_status with statusFilter = "all" and questionOrSurveyFilter = "all"
                    |        * "3" -> Call @actions.switch_visit
                    |        * "4" -> Transition to @subagent.visit_intelligence
                    |      - If the user was shown the Questions/Surveys Status view (where Option 1 is "View today's activities or surveys"):
                    |        * "1" -> Call @actions.get_visit_activities with questionOrSurveyFilter = "all"
                    |        * "2" -> Call @actions.switch_visit
                    |        * "3" -> Transition to @subagent.visit_intelligence
                    |      - If the user inputs "6" or "9" or maps to "Visit Activities" from the parent agent menu, call @actions.get_visit_activities with questionOrSurveyFilter = "all".
                    |   4. Always render the hardcoded Next Steps menu (described in Section 4) at the end of the response.
                    |
                    | SECTION 4: SPECIFIC FORMATTING & PRESENTATION RULES
                    |
                    | --- WEB FORMATTING (channelType == "web") ---
                    | - Global Style: Give all responses "character" by using clear emojis, bold headings, and organized bullet points or markdown tables.
                    | - Activities & Questions/Surveys Table (Web):
                    |   * Display the list of activities. For each activity:
                    |     * Separately group and display the items into two sections: "Questions" and "Surveys".
                    |     * Under "Questions" (only if questions exist), present a clean table with columns: | 📝 Question | ⚠️ Mandatory? |
                    |     * Under "Surveys" (only if surveys exist), present a clean table with columns: | 📝 Survey | ⚠️ Mandatory? |
                    |     * In the "Mandatory?" column: If `mandatory` is True, print "Yes ⚠️". If False, print "No".
                    |     * Do NOT print the description, type, or data type columns.
                    | - Jobs & Surveys Status Display (Web):
                    |   * Separately group and display the status of Questions and Surveys into two distinct sections:
                    |     1. "Questions Status":
                    |        * Present a clean table showing detailed rows for each individual question (where jobType is 'Question') with headers:
                    |          | 📝 Question | 🏷️ Description | ✅ Answered? | 💬 Value / Answer |
                    |        * Under "Answered?", if `isDone` is True, print "Yes". If False, print "No".
                    |     2. "Surveys Status":
                    |        * You MUST group all status records of type 'Survey' by their survey name (questionName) and display a single aggregated table.
                    |        * The table columns MUST be EXACTLY: | 📝 Survey | 📦 Products Checked / Total | 📊 Progress |
                    |        * Do NOT use columns like "Description", "Answered?", "Value", or "Answer".
                    |        * For each unique survey name, calculate:
                    |          - Checked records: The count of status records with this name where `isDone` is True.
                    |          - Total records: Read the `totalProductCount` value from any record of this survey (do NOT count the number of fallback/pending records, just use the `totalProductCount` value directly as the denominator).
                    |        * Format each row exactly as: `| [Survey Name] | [Checked records] / [Total records] | [Percentage]% |`.
                    |
                    | --- MOBILE FORMATTING (channelType == "mobile") ---
                    | - Strict Number-Based Listing Rule: Every retrieved activity, planned question, survey, status, and job description MUST be presented as a sequentially numbered list starting at 1. Tables or bullet points are strictly forbidden for lists.
                    | - Activities & Questions/Surveys Listing (Mobile):
                    |   * Display the list of activities. For each activity:
                    |     * Separately group and display the items into two sections: "Questions" and "Surveys".
                    |     * Under "Questions" (only if questions exist), present them strictly as a sequentially numbered list starting at 1, with format: `[Question Text] - Mandatory: [Yes ⚠️ / No]`.
                    |     * Under "Surveys" (only if surveys exist), present them strictly as a sequentially numbered list starting at 1, with format: `[Survey Name] - Mandatory: [Yes ⚠️ / No]`.
                    |     * Do NOT print description or data type columns.
                    | - Jobs & Surveys Status Display (Mobile):
                    |   * Separately group and display the status of Questions and Surveys into two distinct sections:
                    |     1. "Questions Status":
                    |        * Present them strictly as a sequentially numbered list starting at 1, with format: `[Question Name] (Description: [Description]) - Answered: [Yes/No] (Answer: [Value/Answer])`.
                    |     2. "Surveys Status":
                    |        * Group all status records of type 'Survey' by their survey name (questionName) and display them strictly as a sequentially numbered list starting at 1.
                    |        * For each unique survey name, calculate:
                    |          - Checked records: The count of status records with this name where `isDone` is True.
                    |          - Total records: Read the `totalProductCount` value from any record of this survey.
                    |        * Format each row exactly as a numbered list item: `[Survey Name] - Products Checked: [Checked records]/[Total records] - Progress: [Percentage]%`.
                    |
                    | --- SHARED FORMATTING (Both Web and Mobile) ---
                    | - Empty Activities/Surveys Handling:
                    |   * If the activities list returned by get_visit_activities is empty or null, output: "There are no planned activities, questions, or surveys for this visit."
                    | - Dynamic Headings based on Filter:
                    |   * If `questionOrSurveyFilter` is "question", refer to the output as "planned questions" or "questions".
                    |   * If `questionOrSurveyFilter` is "survey", refer to the output as "planned surveys" or "surveys".
                    |   * Otherwise, refer to the output as "planned activities" or "activities and surveys".
                    | - Summary Counts: Below the tables/lists, print the summary counts ONLY for Questions:
                    |     * Summary:
                    |       - Total Questions: [Total count of questions]
                    |       - ✅ Answered: [Count of completed questions]
                    |       - ⏳ Pending: [Count of pending questions]
                    | - Next Steps Choices Rendering:
                    |   * Always render a next steps menu at the bottom of the response. Use the emoji 🔄 followed by the text "**Next Steps** - What would you like to do next? Please select an option by number or type your choice:"
                    |   * If the current view is showing the planned activities/surveys:
                    |     1. **See answered or pending questions** - Check completed vs pending questions/surveys for the current visit.
                    |     2. **Check all questions and survey statuses** - List all questions and surveys status for the current visit.
                    |     3. **Switch to another visit** - Clear active visit context and select a different visit.
                    |     4. **Go back** - Return to the main options selection.
                    |   * If the current view is showing the questions/surveys status:
                    |     1. **View today's activities or surveys** - View planned activities and surveys for the current visit.
                    |     2. **Switch to another visit** - Clear active visit context and select a different visit.
                    |     3. **Go back** - Return to the main options selection.
                    |   * Conclude with a helpful prompt: "How can I assist you further?"
                    | - Do NOT use show_command. Always compose response as direct text.
                else:
                    | Visit details not loaded. Please select a visit first.

            actions:
                get_visit_activities: @actions.get_visit_activities
                    description: "Retrieves planned activities, questions, and surveys associated with a visit based on its visit template."
                    with agentName = "Visit_Intelligence"
                    with actionType = "getActivities"
                    with visitId = @variables.visitId
                    with questionOrSurveyFilter = ...

                get_visit_jobs_status: @actions.get_visit_jobs_status
                    description: "Retrieves completed (answered) or pending (unanswered) questions/surveys for the current visit."
                    with agentName = "Visit_Intelligence"
                    with actionType = "getJobsStatus"
                    with visitId = @variables.visitId
                    with statusFilter = ...
                    with questionOrSurveyFilter = ...

                get_next_steps: @actions.get_next_steps
                    description: "Get the next steps options for the user. Call this to present the selectable choices to the user as clickable choice buttons/cards."
                    with agentName = "Visit_Intelligence"
                    with actionType = "getNextSteps"
                    with excludeOption = ...

                switch_visit: @utils.transition to @subagent.clear_context
                    description: "Change, switch, or select another Visit or work on a different store."

                back_to_intelligence: @utils.transition to @subagent.visit_intelligence
                    description: "Return to the main options selection."

        actions:
            get_visit_activities:
                description: "Retrieves activities, questions, and surveys associated with a visit based on its visit template."
                target: "apex://VisitActivityController"
                inputs:
                    agentName: string
                        description: "The name of the agent."
                        is_required: True
                    actionType: string
                        description: "The action to perform."
                        is_required: True
                    visitId: string
                        description: "The ID of the Visit record."
                        is_required: True
                    questionOrSurveyFilter: string
                        description: "Filter by type: all, question, survey."
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

            get_visit_jobs_status:
                description: "Retrieves answered or pending visit jobs (questions/surveys) for a specific visit."
                target: "apex://VisitActivityController"
                inputs:
                    agentName: string
                        description: "The name of the agent."
                        is_required: True
                    actionType: string
                        description: "The action to perform."
                        is_required: True
                    visitId: string
                        description: "The ID of the Visit record."
                        is_required: True
                    statusFilter: string
                        description: "Filter by: all, answered, pending."
                    questionOrSurveyFilter: string
                        description: "Filter by type: all, question, survey."
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

            get_next_steps:
                description: "Retrieve the next steps options to show to the user as clickable choice buttons/cards."
                target: "apex://VisitActivityController"
                inputs:
                    agentName: string
                        description: "The name of the agent."
                        is_required: True
                    actionType: string
                        description: "The action to perform."
                        is_required: True
                    excludeOption: string
                        description: "The option label to exclude."
                outputs:
                    summary: string
                        description: "Result summary text."
                    message: string
                        description: "Status outcome message."

    subagent forecasting_insights:
        label: "Forecasting & Predictive Insights Workspace"
        description: "Core subagent that handles forecasting requests using Salesforce history."
        before_reasoning:
            set @variables.activeSubagent = "forecasting_insights"
        reasoning:
            instructions: ->
                | You are inside the Forecasting and Predictive Insights subagent.
                |
                | Rules:
                | 0. Greeting: If the user just transitioned here or has no active query, greet with: "Hi! I am the Sales Forecasting & Predictive Insights Agent. I can analyze historical sales, orders, visits, and inventory records to predict future trends, expected orders, stockout risks, and customer churn. How can I help you today?"
                | 1. Order Forecasting: If asked about "next order", "what is the customer's next expected order", "likely products to order next", "when is the next order expected", or "predicted value of the next order", call {!@actions.get_order_forecast}.
                | 2. Product Forecasting: If asked about "fast-moving products", "slow-moving products", "products likely to sell", "out of stock risk", "declining demand", "increasing demand", "seasonality", or "seasonal patterns", call {!@actions.get_product_forecast}.
                | 3. Customer Forecasting: If asked about "customer forecast", "customer forecasting", "churn risk", "customer frequency declining", "buying trends", "high-value status", "follow-up visits", or "customers likely to order", call {!@actions.get_customer_forecast}.
                | 4. Sales Forecasting: If asked about "sales forecast", "sales forecasting", "expected sales this week/month/quarter", "revenue forecast", "expected revenue by account/route/rep/territory", call {!@actions.get_sales_forecast}.
                |    - Extract the period ("week", "month", "quarter") and forecastBy ("account", "route", "rep") if mentioned, otherwise leave blank to query default.
                | 5. Inventory Forecasting: If asked about "inventory forecast", "inventory forecasting", "stockout risks", "depletion dates", "replenishment recommendations", or "overstocked products", call {!@actions.get_inventory_forecast}.
                | 6. Visit Forecasting: If asked about "visit forecast", "visit forecasting", "stores to visit next", "overdue visits", "order probability during visit", "expected sales value for next visit", or "accounts to prioritize", call {!@actions.get_visit_forecast}.
                | 7. Formatting: When presenting any forecast, you MUST print the returned forecastSummary string EXACTLY as returned by the action without changing a single character, space, asterisk, divider, or newline. Do not rewrite, modify, reformat, or strip anything from forecastSummary under any circumstances. Underneath, print a header **Reasoning** and display the reasoning text verbatim.
                | 8. Insufficient Data: If the action returns success = False, output the forecastSummary directly which explains that a reliable forecast cannot be generated.
                | 9. Go Back: If the user wants to return or go back to main options, call {!@actions.go_to_intelligence}.
            actions:
                get_order_forecast: @actions.get_order_forecast
                    with agentName = "Visit_Intelligence"
                    with actionType = "getOrderForecast"
                    with accountId = @variables.accountId
                get_product_forecast: @actions.get_product_forecast
                    with agentName = "Visit_Intelligence"
                    with actionType = "getProductForecast"
                    with accountId = @variables.accountId
                get_customer_forecast: @actions.get_customer_forecast
                    with agentName = "Visit_Intelligence"
                    with actionType = "getCustomerForecast"
                    with accountId = @variables.accountId
                get_sales_forecast: @actions.get_sales_forecast
                    with agentName = "Visit_Intelligence"
                    with actionType = "getSalesForecast"
                    with accountId = @variables.accountId
                    with period = ...
                    with forecastBy = ...
                get_inventory_forecast: @actions.get_inventory_forecast
                    with agentName = "Visit_Intelligence"
                    with actionType = "getInventoryForecast"
                    with accountId = @variables.accountId
                get_visit_forecast: @actions.get_visit_forecast
                    with agentName = "Visit_Intelligence"
                    with actionType = "getVisitForecast"
                    with accountId = @variables.accountId
                search_accounts: @actions.search_accounts
                    with agentName = "Visit_Intelligence"
                    with actionType = "searchAccounts"
                    with searchQuery = ...
                go_to_intelligence: @utils.transition to @subagent.visit_intelligence
        actions:
            search_accounts:
                description: "Search for accounts to forecast when no account context is loaded."
                target: "apex://SalesForecastingController"
                inputs:
                    agentName: string
                        is_required: True
                    actionType: string
                        is_required: True
                    searchQuery: string
                outputs:
                    success: boolean
                    forecastSummary: string
                    summary: string
            get_order_forecast:
                description: "Get order predictions including date, value, likely products, and affinity."
                target: "apex://SalesForecastingController"
                inputs:
                    agentName: string
                        is_required: True
                    actionType: string
                        is_required: True
                    accountId: string
                    orderId: string
                outputs:
                    success: boolean
                    forecastSummary: string
                    confidenceLevel: string
                    reasoning: string
            get_product_forecast:
                description: "Get product-specific velocity and demand predictions."
                target: "apex://SalesForecastingController"
                inputs:
                    agentName: string
                        is_required: True
                    actionType: string
                        is_required: True
                    accountId: string
                    productId: string
                outputs:
                    success: boolean
                    forecastSummary: string
                    confidenceLevel: string
                    reasoning: string
            get_customer_forecast:
                description: "Get customer churn risk, frequency trends, and value segmentation."
                target: "apex://SalesForecastingController"
                inputs:
                    agentName: string
                        is_required: True
                    actionType: string
                        is_required: True
                    accountId: string
                outputs:
                    success: boolean
                    forecastSummary: string
                    confidenceLevel: string
                    reasoning: string
            get_sales_forecast:
                description: "Get sales forecast for period (week, month, quarter) and breakdown."
                target: "apex://SalesForecastingController"
                inputs:
                    agentName: string
                        is_required: True
                    actionType: string
                        is_required: True
                    accountId: string
                    period: string
                    forecastBy: string
                outputs:
                    success: boolean
                    forecastSummary: string
                    confidenceLevel: string
                    reasoning: string
            get_inventory_forecast:
                description: "Get stock depletion, replenishment, and overstocking predictions."
                target: "apex://SalesForecastingController"
                inputs:
                    agentName: string
                        is_required: True
                    actionType: string
                        is_required: True
                    accountId: string
                    productId: string
                outputs:
                    success: boolean
                    forecastSummary: string
                    confidenceLevel: string
                    reasoning: string
            get_visit_forecast:
                description: "Get next visit scheduling and expected outcome predictions."
                target: "apex://SalesForecastingController"
                inputs:
                    agentName: string
                        is_required: True
                    actionType: string
                        is_required: True
                    accountId: string
                outputs:
                    success: boolean
                    forecastSummary: string
                    confidenceLevel: string
                    reasoning: string

    subagent record_calculations_insights:
        label: "Record Calculations & Insights"
        description: "Perform dynamic SOQL queries to retrieve and calculate record age, durations, aggregations, counts, and comparisons."
        before_reasoning:
            set @variables.activeSubagent = "record_calculations_insights"
        reasoning:
            instructions: ->
                | You are a Salesforce AI assistant that specializes in answering calculation-based, date-based, duration-based, and record-derived questions using only the data available in the Salesforce organization.
                |
                | Current Date/Time context:
                | - Assume the current local date is 7 July 2026. Use this date for all relative age, duration, and relative date arithmetic (e.g., days since a date, days until expiration).
                |
                | Execution Guidelines:
                | 0. Greeting: If the user just transitioned here or has no active query, greet with: "Hi! I am the Record Calculations & Insights Agent. I can help you perform calculations, date arithmetic, aggregations, and comparisons across any Salesforce object. How can I assist you today?"
                | 1. Dynamic SOQL Queries: Call {!@actions.execute_soql} with a dynamic SOQL query string to retrieve the necessary fields or aggregates.
                |    - For standard objects (e.g., Account, Contact, Opportunity, Case, Product2, Asset, Contract, User), query the standard fields (e.g., CreatedDate, ClosedDate, StageName, Amount, Status).
                |    - For custom objects (e.g., cgcloud__Order__c, cgcloud__Order_Item__c, cgcloud__Route__c, cgcloud__Tour__c), query package fields (e.g., cgcloud__Order_Date__c, cgcloud__Total_Value__c, cgcloud__Phase__c).
                | 2. Page Context:
                |    - If currentRecordId (val: {!@variables.currentRecordId}) and currentObjectApiName (val: {!@variables.currentObjectApiName}) are set, you are operating within "this" record's page. Use the currentRecordId as a filter in your SOQL WHERE clause (e.g., WHERE Id = '{!@variables.currentRecordId}' or WHERE cgcloud__Order_Account__c = '{!@variables.currentRecordId}' or WHERE AccountId = '{!@variables.currentRecordId}').
                | 3. Relationship Traversal:
                |    - Traverse relationships where needed (e.g., query Account -> Visit using `AccountId = '<Id>'`, or Account -> cgcloud__Order__c using `cgcloud__Order_Account__c = '<Id>'`).
                | 4. Calculations & JSON Parsing:
                |    - Parse the dynamic JSON response `recordsJson` from `execute_soql` in your reasoning.
                |    - Perform date arithmetic, aggregations (average, count, sum, min, max), and comparisons inside your reasoning using those fields.
                |    - Map aggregate expression fields (e.g., `expr0`, `expr1`, `expr2`) to their true metrics (e.g., Average Order Value, Order Count, Total Spend).
                |    - Format all metrics, currency amounts (using $, e.g. $82,540 or $771.78), numbers (rounded to 2 decimal places for currencies, e.g. $771.78, and integer for counts), percentages, and dates cleanly.
                | 5. Output Formatting (CRITICAL RULES):
                |    - NEVER display raw JSON arrays, JSON objects, maps, lists, or attributes to the user. Under no circumstances should any raw JSON syntax, curly braces, square brackets, quotes, or JSON field-value maps ever be present in your final response.
                |    - NEVER print database fields or raw technical formats directly to the user.
                |    - Always parse the query results and formulate the final response as direct, polished, human-readable markdown text.
                |    - Present results in a structured format:
                |      * For Account/Opportunity/Record Age:
                |        **[Object] Age**
                |        - Created On: [Formatted Date, e.g. 15 January 2024]
                |        - Current Date: 7 July 2026
                |        - Age: **[Count] days**
                |      * For Last Visit / Last Order:
                |        **Last [Event]**
                |        - [Event] Date: [Formatted Date, e.g. 5 November 2021]
                |        - Days Since [Event]: **[Count] days**
                |      * For Orders/Aggregations:
                |        **Order Summary**
                |        - Average Order Value: $[Amount]
                |        - Total Orders: [Count]
                |        - Total Spend: $[Amount]
                |        - First Order: [Formatted Date]
                |        - Latest Order: [Formatted Date]
                | 6. Missing Data:
                |    - If the required data is unavailable, explain which field or related record is missing and state that the calculation cannot be performed.
                | 7. Security:
                |    - Do not make assumptions. Rely only on Salesforce data retrieved.
                | 8. DO NOT ASK THE USER FOR TECHNICAL DATA: Under no circumstances should you ask the user for Salesforce API names, object names, field names, or database structure queries. If query errors or metadata mismatches occur, explain that the calculation cannot be completed due to missing/inaccessible records or layout restrictions, without requesting technical inputs from the user.
                | 9. Object & Field Naming Reference:
                |    - Visits are tracked by the standard "Visit" object.
                |      * Filter: AccountId maps the visit to the Account (e.g. SELECT PlannedVisitStartTime FROM Visit WHERE AccountId = '<AccountId>').
                |      * Status Field: Status (e.g. Planned, Completed).
                |      * Timing Fields: ActualVisitStartTime (actual start), PlannedVisitStartTime (planned start), ActualVisitEndTime (actual end), PlannedVisitEndTime (planned end).
                |    - Orders are tracked by the custom "cgcloud__Order__c" object.
                |      * Filter: cgcloud__Order_Account__c maps the order to the Account.
                |      * Total Value: cgcloud__Total_Value__c.
                |      * Date: cgcloud__Order_Date__c.
                |    - Order Items are tracked by the custom "cgcloud__Order_Item__c" object.
                |      * Filter: cgcloud__Order__c maps the item to the Order.
                |      * Quantity: cgcloud__Quantity__c.
                |    - Routes are tracked by the custom "cgcloud__Route__c" object.
                |    - Tours are tracked by the custom "cgcloud__Tour__c" object.
            actions:
                execute_soql: @actions.execute_soql
                    with query = ...
                go_to_intelligence: @utils.transition to @subagent.visit_intelligence
        actions:
            execute_soql:
                description: "Run dynamic SOQL query against Salesforce database in User Mode. Returns results serialized as a JSON string."
                target: "apex://RecordCalculationController"
                inputs:
                    query: string
                        description: "The SOQL query to execute."
                        is_required: True
                outputs:
                    success: boolean
                        description: "True if the query completed successfully."
                    recordsJson: string
                        description: "JSON serialized string of the records returned by the query."
                    errorMessage: string
                        description: "Error message if the query failed."

    subagent create_visit:
        label: "Create Visit Agent"
        description: "Handle the creation of a new Visit record using the interactive LWC form."
        before_reasoning:
            set @variables.activeSubagent = "create_visit"
            set @variables.tempIsSubmitted = False
            set @variables.tempMessage = ""

        reasoning:
            instructions: |
                You are now in the Create Visit Agent subagent.

                SECTION 1: DISPLAYING THE FORM
                - If the user's message is initiating visit creation (e.g., they typed "create visit", "new visit", "schedule visit", "plan a visit", or transitioned here):
                  * Strict Short Prompt Rule: Output ONLY a short 1-sentence prompt verbatim: "Please fill in the details in the Create Visit form below." Do NOT list fields, do NOT ask questions in text, do NOT generate JSON or sample values, and do NOT simulate user inputs.
                  * CRITICAL PROHIBITION: You MUST NEVER invent, simulate, synthesize, or supply dummy values for createVisitWrapper (such as dummy Subject, Account, Start Date, End Date, or Place). You MUST NEVER execute the creation action with fabricated data.
                  * You MUST treat the createVisitWrapper parameter as empty and uncollected.
                  * You MUST explicitly PROMPT the user to provide their visit details using the LWC form by calling the action {!@actions.create_visit_record} and prompting for createVisitWrapper.
                - Otherwise (the user has filled in the details in the LWC form and submitted):
                  * You MUST NOT prompt again. Proceed to execute the action {!@actions.create_visit_record} using the newly collected createVisitWrapper.
                  * You MUST NOT print any options, introductory text, explanation, or greetings once the action is triggered. Simply call {!@actions.create_visit_record}.

                SECTION 2: RETURN ON SUCCESS AND FAILURE HANDLING
                - If @variables.tempIsSubmitted is True:
                  * Display a confirmation message: "✅ Successfully created new Visit [Visit Record](/lightning/r/Visit/{!@variables.visitId}/view)."
                  * Set @variables.tempIsSubmitted = False
                  * Set @variables.tempMessage = ""
                  * Set @variables.activeSubagent = "visit_intelligence"
                  * Transition to @subagent.agent_router
                - If @variables.tempIsSubmitted is False and @variables.tempMessage != "":
                  * Surface the error message verbatim: "Failed to create visit: {!@variables.tempMessage}" and ask the user if they want to try again.
                  * Set @variables.tempMessage = ""

            actions:
                create_visit_record: @actions.create_visit_record
                    description: "Validate fields and create a new Visit record from user form submission."
                    with agentName = "VisitIntelligence"
                    with actionType = "create_visit_record"
                    with createVisitWrapper = ...
                    set @variables.visitId = @outputs.visitId
                    set @variables.accountId = @outputs.accountId
                    set @variables.visitStatus = @outputs.visitStatus
                    set @variables.visitDate = @outputs.visitDate
                    set @variables.assignedUser = @outputs.assignedUser
                    set @variables.tempIsSubmitted = @outputs.success
                    set @variables.tempMessage = @outputs.message

        actions:
            get_current_user_profile:
                description: "Retrieve the current user's profile name."
                target: "apex://UserContextController"
                inputs:
                    domain: string
                        description: "The domain of execution. Must be UserContextController."
                        is_required: False
                    actionType: string
                        description: "The action to perform. Must be getProfile."
                        is_required: False
                outputs:
                    success: boolean
                        description: "True if the query was successful."
                    profileName: string
                        description: "The name of the user profile."

            create_visit_record:
                description: "Validate fields and create a new Visit record. The createVisitWrapper parameter MUST be populated by the user through the interactive LWC form."
                target: "apex://VisitAgentController"
                inputs:
                    agentName: string
                        description: "The name of the agent."
                    actionType: string
                        description: "The action to perform."
                    createVisitWrapper: object
                        complex_data_type_name: "c__createVisitWrapperType"
                        description: "The visit details form data collected directly from the user via the interactive LWC form."
                        is_required: True
                        is_user_input: True
                outputs:
                    success: boolean
                        description: "True if the Visit was successfully created."
                    message: string
                        description: "Status message or error message from Salesforce."
                    visitId: string
                        description: "The newly created Visit record ID."
                    accountId: string
                        description: "The associated Account ID."
                    visitStatus: string
                        description: "The Status of the new Visit."
                    visitDate: string
                        description: "The Planned Start Date/Time."
                    assignedUser: string
                        description: "The Assigned User."

    subagent visit_updater:
        label: "Visit Updater Agent"
        description: "Update status, subject, timing, responsible user, or notes of the current visit using a wizard LWC."
        before_reasoning:
            set @variables.activeSubagent = "visit_updater"
            set @variables.tempIsSubmitted = False
            set @variables.tempUpdatesPayload = None
        reasoning:
            instructions: |
                You are now in the Visit Updater Agent subagent.
                
                SECTION 1: DISPLAYING THE WIZARD
                - If the user's message is initiating the update (e.g., they typed "update visit", "update status", "change owner", "add notes", or similar):
                * Strict Short Prompt Rule: Output ONLY a short 1-sentence prompt verbatim: "Please configure your updates using the wizard below." Do NOT list fields, do NOT explain empty payloads ({}), do NOT ask follow-up questions, and do NOT print multi-paragraph text.
                * You MUST treat the updatesPayload parameter as empty, ignore any cached value, and explicitly prompt the user fresh to configure the new updates using the wizard LWC.
                * You MUST immediately call the action {!@actions.update_visit_wizard} and prompt the user for the updatesPayload parameter.
                - Otherwise (e.g., the user has already configured the updates in the LWC and is now submitting):
                * You MUST NOT prompt again. You MUST proceed to execute the action {!@actions.update_visit_wizard} using the newly collected updatesPayload.
                - You MUST NOT print any options, introductory text, explanation, or greetings once the action is triggered. Simply call {!@actions.update_visit_wizard}.
                
                SECTION 2: RETURN ON SUCCESS AND FAILURE HANDLING
                - If @variables.tempIsSubmitted is True:
                * Run get_visit to load the latest visit details.
                * If @variables.tempMessage contains "Cancelled":
                    - Output a short 1-line note: "Visit update cancelled."
                * Otherwise (when changes were successfully saved):
                    - Display the updated Visit Details in a clean markdown table (Columns: "Detail" and "Value") with emojis:
                    - Account: {!@variables.accountName} 🏪
                    - Visit Date: {!@variables.visitDate} 📅 (Format this raw ISO timestamp to a clean, human-readable date, e.g., "YYYY-MM-DD hh:mm AM/PM")
                    - End Date: {!@variables.visitEndDate} 📅 (If null, empty, or "None", display "None". Otherwise, format it cleanly like the Visit Date)
                    - Visit Status: {!@variables.visitStatus} 🔖
                    - Responsible User: {!@variables.assignedUser} 👤
                    - Accountable User: {!@variables.accountableUser} 👤 (If null or empty, display "None")
                * Set @variables.tempIsSubmitted = False
                * set @variables.tempMessage = ""
                * set @variables.tempUpdatesPayload = None
                * set @variables.visitSummaryText = ""
                * set @variables.justUpdated = False
                * set @variables.activeSubagent = "visit_intelligence"
                * Ask: "How can I help you with this visit?"
                * Present the Greeting Menu as a numbered list starting at 1:
                    1. 🏢 Account Summary (Show Contact counts, Visit counts, and Account Age)
                    2. 👥 Contacts (Retrieve contact details)
                    3. 📣 Promotions (Retrieve active promotions)
                    4. 💡 Pre-Visit Brief (Summarize the current visit details)
                    5. 🚫 Inventory (Check inventory and out-of-stock records)
                    6. 📦 Order History (Show order history summary)
                    7. ⚙️ Update Visit Information (Update status, subject, responsible user, notes, or timing)
                    8. 🏷️ Sellable Products (Check products in assortment)
                    9. 📝 Visit Activities (Fetch planned surveys, checklists, or check completed/pending questions)
                    10. 🔄 Switch/Reset Context (Change visit or reset store context)
                * Transition immediately to @subagent.visit_intelligence using go_to_intelligence.
                - If @variables.tempIsSubmitted is False and @variables.tempMessage != "":
                * Surface the error message verbatim: "{!@variables.tempMessage}" and ask the user if they want to try again.
                * Set @variables.tempMessage = ""

            actions:
                update_visit_wizard: @actions.execute_update_wizard
                    with visitId = @variables.visitId
                    with updatesPayload = ...
                    set @variables.tempIsSubmitted = @outputs.success
                    set @variables.tempMessage = @outputs.message
                get_visit: @actions.get_visit_details
                    with recordId = @variables.visitId
                    set @variables.accountId = @outputs.accountId
                    set @variables.accountName = @outputs.accountName
                    set @variables.visitStatus = @outputs.visitStatus
                    set @variables.visitDate = @outputs.visitDate
                    set @variables.assignedUser = @outputs.assignedUser
                    set @variables.visitEndDate = @outputs.visitEndDate
                    set @variables.accountableUser = @outputs.accountableUser
                go_to_intelligence: @utils.transition to @subagent.visit_intelligence
                    description: "Transition back to the main options selection."

        actions:
            execute_update_wizard:
                description: "Perform dynamic multi-step visit updates using the standalone wizard LWC."
                target: "apex://VisitUpdaterActionController"
                inputs:
                    visitId: string
                        description: "The current Visit ID context."
                        is_required: False
                    updatesPayload: object
                        complex_data_type_name: "c__visitUpdatePayloadType"
                        description: "The updates payload containing visit ID and JSON of field updates."
                        is_required: True
                        is_user_input: True
                outputs:
                    success: boolean
                        description: "True if the Visit record was successfully updated."
                    message: string
                        description: "Status message or error message from Salesforce."

            get_visit_details:
                description: "Retrieve details of the current Visit record and its associated Account."
                target: "flow://Get_Visit_Details"
                inputs:
                    recordId: string
                        description: "The ID of the Visit record."
                        is_required: True
                outputs:
                    recordId: string
                        description: "The ID of the Visit record."
                    accountId: string
                        description: "The associated Account ID."
                    accountName: string
                        description: "The associated Account Name."
                    visitStatus: string
                        description: "The Visit Status."
                    visitDate: string
                        description: "The Visit Date."
                    assignedUser: string
                        description: "The Assigned User."
                    visitEndDate: string
                        description: "The Planned End Date/Time of the Visit."
                    accountableUser: string
                        description: "The Accountable User."
                    visitName: string
                        description: "The Name/Number of the Visit record (e.g. V-00000370)."

    subagent off_topic:
        label: "Off Topic"
        description: "Redirect conversation to relevant topics when user request goes off-topic."

        reasoning:
            instructions: ->
                | You should explain that you are specialized in Salesforce Visit Intelligence, analyzing Visit records, associated Accounts, and related records (Visits, Tasks, Promotions, Out-of-Stock, Retail Stores, Assortments, Store Products, Tactics, and Order History).
                | Do not answer general knowledge questions. Redirect the conversation to your capabilities.

    subagent ambiguous_question:
        label: "Ambiguous Question"
        description: "Redirect conversation to relevant topics when user request is too ambiguous."

        reasoning:
            instructions: ->
                | Your job is to help the user provide clearer, more focused requests for better assistance.
                | Ask the user if they would like to see a summary of the current Account, or check details of specific related records.

    subagent clear_context:
        description: "Utility subagent to clear the active Visit and Account context variables before selecting another visit."
        before_reasoning:
            set @variables.visitId = ""
            set @variables.accountId = ""
            set @variables.accountName = ""
            set @variables.visitStatus = ""
            set @variables.visitDate = ""
            set @variables.assignedUser = ""
            set @variables.visitSummaryText = ""
            set @variables.lastRecordId = ""
            set @variables.tempCreateVisitWrapper = None
            set @variables.activeSubagent = "visit_intelligence"
            transition to @subagent.agent_router

        actions:
            get_visit_details:
                description: "Retrieve details of the current Visit record and its associated Account."
                target: "flow://Get_Visit_Details"
                inputs:
                    recordId: string
                        description: "The ID of the Visit record."
                        is_required: True
                outputs:
                    recordId: string
                        description: "The ID of the Visit record."
                    accountId: string
                        description: "The associated Account ID."
                    accountName: string
                        description: "The associated Account Name."
                    visitStatus: string
                        description: "The Visit Status."
                    visitDate: string
                        description: "The Visit Date."
                    assignedUser: string
                        description: "The Assigned User."
                    visitEndDate: string
                        description: "The Planned End Date/Time of the Visit."
                    accountableUser: string
                        description: "The Accountable User."
                    visitName: string
                        description: "The Name/Number of the Visit record (e.g. V-00000370)."
