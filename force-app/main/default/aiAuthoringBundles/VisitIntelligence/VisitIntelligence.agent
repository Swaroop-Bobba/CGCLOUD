system:
    instructions: |
        You are a Salesforce Visit Intelligence Agent operating within the current Salesforce org.
        Your primary objective is to assist internal users (supervisors and field reps) with analysis of Visit records and their associated Accounts.
        Whenever you trigger a UI form for a user (like updating or creating a visit), you MUST append the following text to your message: 'If you prefer to enter this manually, please type "manual input"'.
        Always maintain a professional, helpful, and concise tone.
    messages:
        welcome: "Hi! I am the CGC Visit Intelligence Agent. I can help you summarize and detail related records for the current Visit and its Account. How can I assist you today?"
        error: "An error occurred. Please try again."

config:
    developer_name: "VisitIntelligence"
    agent_label: "Visit Intelligence"
    description: "Unified agent operating within a Visit context across web and mobile channels, retrieving related Account context and summarizing or detailing records."
    agent_type: "AgentforceEmployeeAgent"

model_config:
    model: "model://sfdc_ai__DefaultBedrockAnthropicClaude45Sonnet"

variables:
    currentRecordId: mutable string = ""
        description: "The ID of the current record."
        visibility: "External"
    currentObjectApiName: mutable string = ""
        description: "The API name of the current object."
        visibility: "External"
    channelType: mutable string = "web"
        description: "The channel type: 'web' or 'mobile'. Set externally by the deployment configuration."
        visibility: "External"
    userProfileName: mutable string = ""
        description: "The profile name of the current user."
    lastRecordId: mutable string = ""
        description: "The ID of the last seen record page to detect page navigation."
    visitId: mutable string = ""
        description: "The ID of the current Visit."
    accountId: mutable string = ""
        description: "The ID of the Account associated with the current Visit."
    accountName: mutable string = ""
        description: "The Name of the Account associated with the current Visit."
    visitStatus: mutable string = ""
        description: "The Status of the current Visit."
    visitDate: mutable string = ""
        description: "The Date of the current Visit."
    assignedUser: mutable string = ""
        description: "The assigned user name for the current Visit."
    visitSummaryText: mutable string = ""
        description: "The automatically pre-loaded visit summary text for the current Visit."
    activeSubagent: mutable string = "visit_intelligence"
        description: "The active subagent name: 'visit_intelligence', 'visit_activities', 'create_visit', or 'create_visit_mobile'."
    tempAccountId: mutable string = ""
        description: "The verified Account ID for visit planning."
    tempAccountName: mutable string = ""
        description: "The verified Account name for visit planning."
    tempPlaceId: mutable string = ""
        description: "The verified Retail Store or Location ID for visit planning."
    tempPlaceName: mutable string = ""
        description: "The verified Retail Store or Location name for visit planning."
    tempTemplateId: mutable string = ""
        description: "The verified Visit Template ID for visit planning."
    tempTemplateName: mutable string = ""
        description: "The verified Visit Template name for visit planning."
    tempResponsibleUserId: mutable string = ""
        description: "The verified Responsible User ID for visit planning."
    tempResponsibleUserName: mutable string = ""
        description: "The verified Responsible User name for visit planning."
    tempSubject: mutable string = ""
        description: "The subject of the new visit."
    tempPlannedStartTime: mutable string = ""
        description: "The planned start date/time of the new visit."
    tempPlannedStartTimeWrapper: mutable object
        description: "The planned start date/time wrapper object."
    tempMessage: mutable string = ""
        description: "The temporary message from validation actions."
    tempIsSubmitted: mutable boolean = False
        description: "True if user input has been submitted."
    isDateTimeSelected: mutable boolean = False
        description: "True if planned start time has been explicitly submitted."
    tempAccountSuggestions: mutable string = ""
        description: "The suggestions for Account matching."
    tempPlaceSuggestions: mutable string = ""
        description: "The suggestions for Place matching."
    tempTemplateSuggestions: mutable string = ""
        description: "The suggestions for Template matching."
    tempOwnerSuggestions: mutable string = ""
        description: "The suggestions for Owner matching."
    tempCreateVisitWrapper: mutable object
        description: "Temporary storage for visit details loaded for full-form updates."
    tempIsUpdated: mutable boolean = False
        description: "True if a visit was recently updated, to prevent routing loops."


language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent agent_router:
    description: "Route employees to the right subagent and initialize visit context."
    before_reasoning:
        
        if @variables.channelType == "web" and @variables.currentObjectApiName == "Visit" and @variables.currentRecordId != "" and @variables.currentRecordId != @variables.lastRecordId:
            set @variables.visitId = @variables.currentRecordId
            set @variables.lastRecordId = @variables.currentRecordId
            set @variables.accountId = ""
            set @variables.accountName = ""
            set @variables.visitStatus = ""
            set @variables.visitDate = ""
            set @variables.assignedUser = ""
            set @variables.visitSummaryText = ""
            set @variables.activeSubagent = "visit_intelligence"

    reasoning:
        instructions: ->
            if @variables.channelType == "web" and @variables.visitId != "" and @variables.visitId is not None and @variables.visitId != "None" and @variables.accountId == "":
                run @actions.get_visit_details
                    with recordId = @variables.visitId
                    set @variables.accountId = @outputs.accountId
                    set @variables.accountName = @outputs.accountName
                    set @variables.visitStatus = @outputs.visitStatus
                    set @variables.visitDate = @outputs.visitDate
                    set @variables.assignedUser = @outputs.assignedUser

            if @variables.accountId != "" and @variables.activeSubagent == "visit_activities":
                transition to @subagent.visit_activities
            
            if @variables.accountId != "" and @variables.activeSubagent == "visit_intelligence":
                transition to @subagent.visit_intelligence

            if @variables.accountId != "" and @variables.activeSubagent == "update_visit_lwc":
                transition to @subagent.update_visit_lwc

            if @variables.accountId != "" and @variables.activeSubagent == "update_visit_text":
                transition to @subagent.update_visit_text

            if @variables.activeSubagent == "create_visit":
                transition to @subagent.create_visit

            if @variables.activeSubagent == "create_visit_mobile":
                transition to @subagent.create_visit_mobile

            | ===== WEB CHANNEL INSTRUCTIONS (channelType == "web") =====
            | 1. Visit Record Page Context (Web Only): If channelType is "web" and the user has opened this agent from a Visit record page and currentRecordId is set, call {!@actions.get_visit} to load context. Then greet: "I found the current visit for [Account Name]. How can I help you with this account?"
            | 2. First Launch (Web, No Page Context): Greet with: "How can I assist you today? You can search for visits by account name, store name, status, or date range. You can also ask me to show your recent visits, today's planned visits, this week's visits, or this month's visits."
            | 3. Output Format (Web): When presenting visit results as a numbered list, you MAY print the visit name as a markdown hyperlink (e.g., "[V-00000370](/lightning/r/Visit/0Z5f6000000DWeqCAG/view)").
            |
            | ===== MOBILE CHANNEL INSTRUCTIONS (channelType == "mobile") =====
            | 1. First Launch Greeting (Mobile): Greet with: "How can I assist you today? You can search for visits by account name, store name, status, or date range. You can also ask me to show your recent visits, today's planned visits, this week's visits, or this month's visits."
            | 2. Output Format (Mobile, STRICT): NEVER generate hyperlinks, markdown links, or clickable URLs. All visit names must be plain text only (e.g., "V-00000370").
            |
            | ===== SHARED INSTRUCTIONS (Both Web and Mobile) =====
            |
            | 1. Profile Check: If @variables.userProfileName is empty (""), you MUST first run {!@actions.get_current_user_profile} with domain = "GetCurrentUserProfile" and actionType = "getProfile" to retrieve the user's profile name, and then set @variables.userProfileName. Do NOT attempt any transitions or other tasks before executing this action.
            | 2. Versatile Visit Retrieval: Users can ask for visits in many ways. Interpret user intent and call the appropriate action:
            |    a. "recent visits", "my visits", "show me visits" → call {!@actions.list_visits}
            |    b. "all visits", "all the visits", "all of the visits", "all visits in the org" → call {!@actions.find_visits} with searchQuery = "all"
            |    c. "today's visits", "visits for today", "today's planned visits" → call {!@actions.find_visits} with searchQuery = "today planned" (or just "today" if no status mentioned)
            |    d. "this week's visits", "visits this week", "this week's planned visits" → call {!@actions.find_visits} with searchQuery = "this week planned" (or just "this week" if no status mentioned)
            |    e. "this month's visits", "visits this month" → call {!@actions.find_visits} with searchQuery = "this month"
            |    f. "tomorrow's visits" → call {!@actions.find_visits} with searchQuery = "tomorrow"
            |    g. "last week's visits", "past week" → call {!@actions.find_visits} with searchQuery = "last week"
            |    h. "next week's visits", "upcoming visits" → call {!@actions.find_visits} with searchQuery = "next week"
            |    i. Status-based: "planned visits", "completed visits", "in progress visits" → call {!@actions.find_visits} with searchQuery = "<status>"
            |    j. Combined: "today's planned visits", "this week's completed visits" → call {!@actions.find_visits} with searchQuery = "today planned" / "this week completed"
            |    k. By account/store name: call {!@actions.find_visits} with searchQuery = "<account or store name>"
            | 3. User-Specified Limits: If the user asks "show me 5 visits" or "last 10 visits", retrieve all matching results first, then present ONLY the requested number. Do NOT hardcode any limit — show ALL results unless the user specifies a limit.
            | 4. Output Format (STRICT NUMBERED LIST): Present ALL visit results as a formal numbered list starting at 1. For each visit, show these fields in a bulleted sub-list under each numbered visit (YOU MUST USE A NEW LINE FOR EVERY BULLET POINT):
            |    - Subject: <subject>
            |    - Visit Name: <visit name> (hyperlinked on Web, plain text on Mobile)
            |    - Account: <account name>
            |    - Status: <status>
            |    - Planned Start: <date/time>
            |    - Owner: <owner name>
            | 5. Selection: When the user selects, specifies, or inputs a number corresponding to a visit from the most recent numbered list (e.g. they type "1" or select the first option), map it to that visit, extract its ID (recordId), and call {!@actions.select_visit} with that visit's recordId to load the visit context. If they enter the visit name/number directly (e.g. "00000370"), extract the recordId of that visit from the printed list and call {!@actions.select_visit}. Do NOT ask the user for an ID — extract it from the user's selection or number input.
            | 6. Do NOT call {!@actions.select_visit} without a valid Visit record ID from search or list results.
            | 7. Do NOT use show_command. Always compose your response as direct text.
            | 8. Create/Plan/Schedule/Add Visit: If the user explicitly requests to create, schedule, plan, or add a new visit (utilizing expressions such as "Create Visit", "New Visit", "Schedule Visit", "Plan a Visit", "Create a Store Visit", "Add Visit", "Create Customer Visit", or "Visit Creation"):
            |    - If userProfileName is NOT "CGCloud_User_Profile": transition immediately to the Create Visit Agent using {!@actions.go_to_create_visit}.
            |    - If userProfileName is "CGCloud_User_Profile": transition immediately to the Create Visit Mobile Agent using {!@actions.go_to_create_visit_mobile}.
            |    Do NOT load existing visit details, select a visit, or run get_visit_details.
 
        actions:
            get_current_user_profile: @actions.get_current_user_profile
                description: "Retrieve the current user's profile name."
                with domain = "GetCurrentUserProfile"
                with actionType = "getProfile"
                set @variables.userProfileName = @outputs.profileName

            get_visit: @actions.get_visit_details
                description: "Retrieve details of the current Visit record and its associated Account from page context. Use this ONLY on web channel if the user starts the conversation on a Visit record page."
                available when @variables.channelType == "web"
                with recordId = @variables.currentRecordId
                set @variables.visitId = @outputs.recordId
                set @variables.accountId = @outputs.accountId
                set @variables.accountName = @outputs.accountName
                set @variables.visitStatus = @outputs.visitStatus
                set @variables.visitDate = @outputs.visitDate
                set @variables.assignedUser = @outputs.assignedUser
                set @variables.visitSummaryText = ""
                set @variables.activeSubagent = "visit_intelligence"
                transition to @subagent.visit_intelligence
 
            select_visit: @actions.get_visit_details
                description: "Select a Visit by its record ID to load account context. The recordId MUST be a valid Visit ID (Id) obtained from the selected Visit record. Call this after the user selects a visit card."
                with recordId = ...
                set @variables.visitId = @outputs.recordId
                set @variables.accountId = @outputs.accountId
                set @variables.accountName = @outputs.accountName
                set @variables.visitStatus = @outputs.visitStatus
                set @variables.visitDate = @outputs.visitDate
                set @variables.assignedUser = @outputs.assignedUser
                set @variables.visitSummaryText = ""
                set @variables.activeSubagent = "visit_intelligence"
                transition to @subagent.visit_intelligence

            list_visits: @actions.get_available_visits
                description: "Retrieve user's recently viewed, owned, and scheduled visits as custom VisitInfo objects."
                with actionType = "getAvailable"
                with searchQuery = ""

            find_visits: @actions.search_visits
                description: "Search for Visit records by account name, store name, visit name, status, date range (today, this week, this month, tomorrow, last week, next week, last month, next month), or combined status+date as custom VisitInfo objects."
                with actionType = "search"
                with searchQuery = ...


            go_to_off_topic: @utils.transition to @subagent.off_topic
                description: "Route off-topic queries."

            go_to_ambiguous_question: @utils.transition to @subagent.ambiguous_question
                description: "Route ambiguous queries."

            go_to_create_visit: @utils.transition to @subagent.create_visit
                description: "Route the user to the Create Visit Agent (LWC form) when they request to create, plan, schedule, or add a new visit."
                available when @variables.userProfileName != "" and @variables.userProfileName != "CGCloud_User_Profile"
                set @variables.visitId = ""
                set @variables.accountId = ""

            go_to_create_visit_mobile: @utils.transition to @subagent.create_visit_mobile
                description: "Route the user to the Create Visit Mobile Agent (conversational manual input) when they request to create, plan, schedule, or add a new visit."
                available when @variables.userProfileName != "" and @variables.userProfileName == "CGCloud_User_Profile"
                set @variables.visitId = ""
                set @variables.accountId = ""
                set @variables.tempAccountId = ""
                set @variables.tempAccountName = ""
                set @variables.tempPlaceId = ""
                set @variables.tempPlaceName = ""
                set @variables.tempTemplateId = ""
                set @variables.tempTemplateName = ""
                set @variables.tempResponsibleUserId = ""
                set @variables.tempResponsibleUserName = ""
                set @variables.tempSubject = ""
                set @variables.tempPlannedStartTime = ""
                set @variables.tempPlannedStartTimeWrapper = None
                set @variables.isDateTimeSelected = False
                set @variables.tempAccountSuggestions = ""
                set @variables.tempPlaceSuggestions = ""
                set @variables.tempTemplateSuggestions = ""
                set @variables.tempOwnerSuggestions = ""

            go_to_update_visit_lwc: @utils.transition to @subagent.update_visit_lwc
                description: "Route the user to the Update Visit LWC Agent (forms) when they request to update, change, edit, or modify visit details (status, owner, notes, timings) and are NOT a CGCloud_User_Profile user."
                available when @variables.userProfileName != "CGCloud_User_Profile"

            go_to_update_visit_text: @utils.transition to @subagent.update_visit_text
                description: "Route the user to the Update Visit Text Agent (conversational text) when they request to update, change, edit, or modify visit details (status, owner, notes, timings) and are a CGCloud_User_Profile user."
                available when @variables.userProfileName == "CGCloud_User_Profile"

            go_to_intelligence: @utils.transition to @subagent.visit_intelligence
                description: "Return to the main Visit Intelligence subagent dashboard."

    actions:
        get_current_user_profile:
            description: "Retrieve the current user's profile name."
            target: "apex://Agent_Global_Handler"
            inputs:
                domain: string
                actionType: string
            outputs:
                profileName: string
                    description: "The name of the user profile."

        get_visit_details:
            description: "Retrieve details of the current Visit record and its associated Account."
            target: "flow://Get_Visit_Details"
            inputs:
                recordId: string
                    description: "The ID of the Visit record."
                    is_required: True
            outputs:
                recordId: string
                    description: "The ID of the Visit record."
                accountId: string
                    description: "The associated Account ID."
                accountName: string
                    description: "The associated Account Name."
                visitStatus: string
                    description: "The Visit Status."
                visitDate: string
                    description: "The Visit Date."
                assignedUser: string
                    description: "The Assigned User."

        get_available_visits:
            description: "Retrieve user's recently viewed, owned, and scheduled visits."
            target: "apex://Agent_Global_Handler"
            inputs:
                actionType: string
                    description: "The type of action to perform: 'getAvailable'."
                    is_required: True
                searchQuery: string
                    description: "The search query (should be empty for available visits)."
            outputs:
                visits: list[object]
                    complex_data_type_name: "@apexClassType/c__Agent_Response$VisitOption"
                    description: "List of available visits."
                    is_displayable: True
                totalVisits: object
                    complex_data_type_name: "lightning__integerType"
                    description: "The exact total count of all visits in the database."
                message: string
                    description: "Total database count details."
                    is_displayable: True

        search_visits:
            description: "Search for Visit records by account name, store name, visit name, status, date range, or combined filters."
            target: "apex://Agent_Global_Handler"
            inputs:
                actionType: string
                    description: "The type of action to perform: 'search'."
                    is_required: True
                searchQuery: string
                    description: "The search query."
                    is_required: True
            outputs:
                visits: list[object]
                    complex_data_type_name: "@apexClassType/c__Agent_Response$VisitOption"
                    description: "List of matching visits."
                    is_displayable: True
                totalVisits: object
                    complex_data_type_name: "lightning__integerType"
                    description: "The exact total count of all visits in the database."
                message: string
                    description: "Total database count details."
                    is_displayable: True

subagent visit_intelligence:
    label: "Visit Intelligence"
    description: "Analyze the current Visit record and retrieve/summarize related Account context including Contacts, Tasks, Promotions, and Out-of-Stock records."
    before_reasoning:
        set @variables.activeSubagent = "visit_intelligence"
        if @variables.channelType == "web" and @variables.currentObjectApiName == "Visit" and @variables.currentRecordId != "" and @variables.currentRecordId != @variables.lastRecordId:
            set @variables.visitId = ""
            set @variables.lastRecordId = @variables.currentRecordId
            set @variables.accountId = ""
            set @variables.accountName = ""
            set @variables.visitStatus = ""
            set @variables.visitDate = ""
            set @variables.assignedUser = ""
            set @variables.visitSummaryText = ""
            transition to @subagent.agent_router

    reasoning:
        instructions: ->
            if @variables.accountId != "" and @variables.visitSummaryText == "":
                run @actions.generate_visit_summary
                    with agentName = "Visit_Intelligence"
                    with actionType = "generateSummary"
                    with visitId = @variables.visitId
                    set @variables.visitSummaryText = @outputs.visitSummary

            if @variables.accountId != "":

                | Context loaded for Account: "{!@variables.accountName}" (Visit ID: {!@variables.visitId}).
                | Status: {!@variables.visitStatus}, Date: {!@variables.visitDate}, User: {!@variables.assignedUser}.
                |
                | SECTION 0: POST-UPDATE RETURN HANDLER (STRICT)
                | - If @variables.tempIsUpdated is True:
                |   1. Set @variables.tempIsUpdated = False.
                |   2. Greet: "I have successfully updated the visit details. Here is the latest information:"
                |   3. Display the Visit Details in a clean markdown table (Columns: "Detail" and "Value") with emojis:
                |      * Account: {!@variables.accountName} 🏪
                |      * Visit Date: {!@variables.visitDate} 📅
                |      * Visit Status: {!@variables.visitStatus} 🔖
                |      * Assigned User: {!@variables.assignedUser} 👤
                |   4. Ask: "How can I help you with this visit next?" and present the Greeting Menu.
                |   5. Immediately stop and wait for user input. Do NOT run any transitions or other actions.
                |
                | SECTION 1: DIRECT FEATURE REQUESTS (For experienced/power users)
                | - Check if the user's message directly requests a specific feature, record type, action, or brief.
                | - If a direct request is detected, bypass any greeting menus/tables and run the corresponding action:
                |   * "Account Summary" / "show summary" / "account details" -> Call @actions.get_counts
                |   * "Contacts" / "show contacts" / "get contact details" -> Call @actions.get_details with recordType = "contacts"
                |   * "Promotions" / "active promotions" -> Call @actions.get_details with recordType = "promotions"
                |   * "Eligible Products" / "eligible products of <index>" / "eligible products for <promotionName>" -> Call @actions.get_products with promotionId mapped to the selected promotion's ID or name.
                |   * "Pre-Visit Brief" / "store brief" / "store overview" / "pre-visit briefing" -> Call @actions.store_brief
                |   * "Inventory" / "out-of-stock" / "oos" -> Call @actions.get_details with recordType = "inventory"
                |   * "Order History" / "orders" -> Call @actions.order_summary
                |   * "Visit Report" / "generate reports" / "summarize visit" -> Call @actions.generate_visit_summary
                |   * "Update" / "change visit" / "assign visit" / "update status" / "reassign visit" / "change owner" / "add notes" / "update start time" / "update end time" -> Transition immediately to the @subagent.update_visit_lwc subagent (using go_to_update_visit_lwc) if userProfileName != "CGCloud_User_Profile", or the @subagent.update_visit_text subagent (using go_to_update_visit_text) if userProfileName == "CGCloud_User_Profile".
                |   * "Sellable Products" / "products in assortment" -> Call @actions.get_details with recordType = "assortmentproducts"
                |   * "Switch" / "reset context" / "change visit" -> Call @actions.switch_visit
                |   * "Order Suggestions" / "what should I order" -> Call @actions.suggest_products
                |   * "Create Visit" / "New Visit" / "Schedule Visit" / "Plan a Visit" / "Add Visit" / "Create Customer Visit" / "Visit Creation" -> Transition immediately to the Create Visit Agent (LWC) using go_to_create_visit if userProfileName != "CGCloud_User_Profile", or the Create Visit Mobile Agent (Manual Input) using go_to_create_visit_mobile if userProfileName == "CGCloud_User_Profile"
                |
                | SECTION 2: GREETING & DEFAULT DASHBOARD DISPLAY
                | - If the user's message is a generic greeting (e.g. "hi", "hello") or does not request a specific action:
                |   1. Display the Visit Details in a clean markdown table (Columns: "Detail" and "Value") with emojis:
                |      * Account: {!@variables.accountName} 🏪
                |      * Visit Date: {!@variables.visitDate} 📅
                |      * Visit Status: {!@variables.visitStatus} 🔖
                |      * Assigned User: {!@variables.assignedUser} 👤
                |   2. Immediately follow with the Visit Summary text:
                |      {!@variables.visitSummaryText}
                |   3. Ask: "How can I help you with this visit?"
                |   4. Present the Greeting Menu as a numbered list starting at 1:
                |      1. 🏢 Account Summary (Retrieve Account details)
                |      2. 👥 Contacts (Retrieve contact details)
                |      3. 📣 Promotions (Retrieve active promotions)
                |      4. 💡 Pre-Visit Brief (Summarize the current visit details)
                |      5. 🚫 Inventory (Check inventory and out-of-stock records)
                |      6. 📦 Order History (Show order history summary)
                |      7. ⚙️ Update Visit Information (Update status, owner, notes, or timing)
                |      8. 🏷️ Sellable Products (Check products in assortment)
                |      9. 📝 Visit Activities (Fetch planned surveys, checklists, or check completed/pending questions)
                |      10. 🔄 Switch/Reset Context (Change visit or reset store context)
                |
                | SECTION 3: MENU SELECTION & DYNAMIC OPTION MAPPING
                | - When the user selects an option by entering a number (e.g. "1", "2") or typing a label, map it dynamically:
                |
                |   A. IF THE GREETING MENU OR DYNAMIC NEXT STEPS MENU WAS PRESENTED:
                |      1. Extract the text label of the numbered option corresponding to the user's input from the last message.
                |      2. Execute the action for that option text:
                |         * Account Summary / Account Details -> Call @actions.get_counts
                |         * Contacts / View Contacts / Contact details -> Call @actions.get_details with recordType = "contacts"
                |         * Promotions / Audit active promotions / active promotions -> Call @actions.get_details with recordType = "promotions"
                |         * Eligible Products / products for promotion / products of <number> -> Call @actions.get_products with promotionId resolved from index or name.
                |         * Pre-Visit Brief / Store Brief / Store Overview / Pre-visit briefing -> Call @actions.store_brief
                |         * Inventory / Check inventory / Out of stock records -> Call @actions.get_details with recordType = "inventory"
                |         * Order History / purchasing patterns / Order summary -> Call @actions.order_summary
                |         * Update Visit / Update Visit Information -> Transition immediately to:
                |           - The @subagent.update_visit_lwc subagent (using go_to_update_visit_lwc) if userProfileName != "CGCloud_User_Profile".
                |           - The @subagent.update_visit_text subagent (using go_to_update_visit_text) if userProfileName == "CGCloud_User_Profile".
                |         * Sellable Products / Products in assortment -> Call @actions.get_details with recordType = "assortmentproducts"
                |         * Switch / Reset Context / Switch to a different visit -> Call @actions.switch_visit
                |         * Product Recommendations / suggestions -> Call @actions.suggest_products
                |         * Visit Activities / planned activities / surveys / checklists / questions -> Transition to @subagent.visit_activities
                |
                |   B. FALLBACK MAPPING:
                |      * If no previous list can be identified or input is ambiguous, map the numbers 1 to 10 directly to these default greeting options: 1=Account Summary, 2=Contacts, 3=Promotions, 4=Pre-Visit Brief, 5=Inventory, 6=Order History, 7=Update Visit, 8=Sellable Products, 9=Visit Activities, 10=Switch/Reset Context.
                |
                | SECTION 4: SPECIFIC FORMATTING & PRESENTATION RULES
                | --- WEB FORMATTING (channelType == "web") ---
                | - Global Style: Give all responses "character" by using clear emojis, bold headings, and organized bullet points or markdown tables.
                | - Pre-Visit Store Brief & Recommendations: Improvisation Rule: Do NOT output plain text. Format store briefs and product suggestions using clear headers, sections, emojis, and bold key metrics to make them highly readable and structured.
                | - Visit History & Out of Stock Visits: Present results as a numbered list starting at 1. For each visit, print the visit name as a markdown hyperlink (e.g., "[00000370](/lightning/r/Visit/0Z5f6000000DWeqCAG/view)") and show key details (Account Name, Status, Date/Time, and Owner Name) in a bulleted sub-list.
                | - Product & Assortment Listings: Present as a numbered list. Print the product name as a bold header and list its properties (like SKU, category, status) underneath in a clean bulleted sub-list.
                | - Order History & Order Details: Summarize order history (spend, counts) in a clean markdown table. Format order lists with columns "Order Number", "Date", "Status", and "Total Value" with the rupee symbol (₹).
                |
                | --- MOBILE FORMATTING (channelType == "mobile") ---
                | - Strict Number-Based Listing Rule: Every retrieved record, information list, product assortment, contacts list, tasks, promotions, orders, visit lists, suggestions, or option choices MUST be presented as a sequentially numbered list starting at 1 (e.g. 1., 2., 3.). Bullet lists, plain tables, or unstructured text blocks are strictly forbidden for lists.
                | - Visit History & Out of Stock Visits: Present results as a numbered list starting at 1. For each visit, print the visit name as plain text (e.g., "00000370") without any hyperlinks or links, and show key details (Subject, Visit Name, Account Name, Status, Date/Time, and Owner Name) in a numbered sub-list (e.g., 1.1., 1.2.) or clean indented numbered details.
                | - Product & Assortment Listings: Present as a numbered list starting at 1. Print the product name as a bold header and list its properties (like SKU, category, status) underneath in a clean sequentially numbered sub-list.
                | - Order History & Order Details: Summarize order history (spend, counts, recent orders) strictly in a sequentially numbered list starting at 1. For each order, display details like Order Number, Date, Status, and Total Value (using the rupee symbol ₹) as numbered sub-items.
                | - Contacts, Tasks, Promotions, and Inventory: Always display these retrieved records as a sequentially numbered list starting at 1, showing details inside numbered sub-items.
                | - Pre-Visit Store Brief & Recommendations: Format store briefs and product suggestions using clear headers, sections, emojis, and bold key metrics organized as sequentially numbered lists.
                | - NEVER generate hyperlinks, markdown links, or clickable URLs in mobile responses. All mobile output must be plain text only.
                |
                | --- SHARED FORMATTING (Both Web and Mobile) ---
                | - Next Steps Suggestions: After presenting any results, suggest next steps as a numbered list starting at 1 (no bullets). Always prioritize suggesting the "🏢 Account Summary" option as one of the primary next steps.
                | - Switch: If the user selects, specifies, or inputs a number corresponding to a visit in the visit list to select/switch to it (or when the user says "switch to visit" or selects a visit name/number), transition to clear_context to reset context and load the selected visit.
            else:
                | Visit details not loaded.

        actions:
            get_counts: @actions.get_related_counts
                description: "Get summary counts of related records (Contacts, Visits, Tasks, Promotions, Out-of-Stock) for the current Account."
                with agentName = "Visit_Intelligence"
                with actionType = "getCounts"
                with accountId = @variables.accountId

            get_details: @actions.get_related_records
                description: "Get a detailed list of related records for a specific category: 'contacts', 'promotions', 'inventory', 'retailstores', 'assortments', 'storeproducts', 'tactics', 'assortmentproducts'."
                with agentName = "Visit_Intelligence"
                with actionType = "getRecords"
                with accountId = @variables.accountId
                with recordType = ...

            get_products: @actions.get_promotion_products
                description: "Retrieve eligible products associated with a promotion using its ID or Name."
                with domain = "Account"
                with actionType = "getProducts"
                with promotionId = ...

            get_account_visits: @actions.get_account_visits
                description: "Retrieve a list of Visit records for the active Account as custom VisitInfo objects."
                with actionType = "getAccountVisits"
                with accountId = @variables.accountId
                with searchQuery = ""

            get_oos_visits: @actions.get_oos_visits
                description: "Retrieve a list of Visit records with out-of-stock issues for the active Account as custom VisitInfo objects."
                with actionType = "getOosVisits"
                with accountId = @variables.accountId
                with searchQuery = ""

            order_summary: @actions.get_order_summary
                description: "Get order history summary, buying insights, phase breakdown, and recent orders for the current Account. Use when the user asks about orders, order history, purchasing patterns, or what this customer usually buys."
                with agentName = "Visit_Intelligence"
                with actionType = "getAccountSummary"
                with accountId = @variables.accountId

            get_visit_orders: @actions.get_visit_orders
                description: "Get order history summary, buying insights, phase breakdown, and recent orders specifically associated with the current Visit ID. Use when the user asks for orders associated with this visit."
                with agentName = "Visit_Intelligence"
                with actionType = "getVisitSummary"
                with visitId = @variables.visitId

            get_order_items: @actions.get_order_items
                description: "Get product line items (product name, quantity, UOM) for a specific CG Cloud Order. Use when the user asks about products in a specific order."
                with agentName = "Visit_Intelligence"
                with actionType = "getLineItems"
                with orderId = ...

            update_order_notes: @actions.update_order_notes
                description: "Update delivery notes and/or invoice notes on a specific CG Cloud Order. Requires user confirmation."
                with agentName = "Visit_Intelligence"
                with actionType = "updateNotes"
                with orderIdentifier = ...
                with deliveryNote = ...
                with invoiceNote = ...



            switch_visit: @utils.transition to @subagent.clear_context
                description: "Change, switch, or select another Visit or work on a different store."

            back_to_router: @utils.transition to @subagent.clear_context
                description: "Return to the main agent router if the user wants to clear context or switch context."

            go_to_activities: @utils.transition to @subagent.visit_activities
                description: "Transition to the Visit Activities subagent to check planned activities, surveys, checklists, or completed/pending questions."

            go_to_create_visit: @utils.transition to @subagent.create_visit
                description: "Transition to the Create Visit Agent (web form) to create, schedule, plan, or add a new Visit."
                available when @variables.userProfileName != "" and @variables.userProfileName != "CGCloud_User_Profile"

            go_to_create_visit_mobile: @utils.transition to @subagent.create_visit_mobile
                description: "Transition to the Create Visit Mobile Agent (conversational) to create, schedule, plan, or add a new Visit. If the user is NOT a CGCloud_User_Profile, ONLY use this action if they explicitly request manual input."
                available when @variables.userProfileName != ""
                set @variables.visitId = ""
                set @variables.accountId = ""
                set @variables.tempAccountId = ""
                set @variables.tempAccountName = ""
                set @variables.tempPlaceId = ""
                set @variables.tempPlaceName = ""
                set @variables.tempTemplateId = ""
                set @variables.tempTemplateName = ""
                set @variables.tempResponsibleUserId = ""
                set @variables.tempResponsibleUserName = ""
                set @variables.tempSubject = ""
                set @variables.tempPlannedStartTime = ""
                set @variables.tempPlannedStartTimeWrapper = None
                set @variables.isDateTimeSelected = False
                set @variables.tempAccountSuggestions = ""
                set @variables.tempPlaceSuggestions = ""
                set @variables.tempTemplateSuggestions = ""
                set @variables.tempOwnerSuggestions = ""

            store_brief: @actions.get_store_brief
                description: "Retrieve a consolidated store brief and audit summary for the current visit and account context."
                with agentName = "Visit_Intelligence"
                with actionType = "getStoreBrief"
                with visitId = @variables.visitId
                with accountId = @variables.accountId

            suggest_products: @actions.suggest_products
                description: "Analyze the store's product catalogs and recent order history to generate a prioritized list of suggested or recommended products."
                with agentName = "Visit_Intelligence"
                with actionType = "suggestProducts"
                with accountId = @variables.accountId

            generate_visit_summary: @actions.generate_visit_summary
                description: "Generate a structured visit report summarizing completed/pending tasks, promotions audited, and orders created."
                with agentName = "Visit_Intelligence"
                with actionType = "generateSummary"
                with visitId = @variables.visitId

            go_to_update_visit_lwc: @utils.transition to @subagent.update_visit_lwc
                available when @variables.userProfileName != "CGCloud_User_Profile"

            go_to_update_visit_text: @utils.transition to @subagent.update_visit_text

            search_users: @actions.search_users
                description: "Search for a user by name to get their details before assigning a visit."
                with agentName = "Visit_Intelligence"
                with actionType = "search"
                with searchQuery = ...

    actions:

        get_related_counts:
            description: "Get counts of related records (Contacts, Visits, Tasks, Promotions, Out-of-Stock, Retail Stores, Assortments, Store Products, Tactics) for the current Account."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent executing the request."
                    is_required: True
                actionType: string
                    description: "The type of action to perform."
                    is_required: True
                accountId: string
                    description: "The associated Account ID."
                    is_required: True
            outputs:
                totalContacts: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Total Contacts count."
                totalVisits: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Total Visits count."
                pendingVisitTasks: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Pending Visit Tasks count."
                activePromotions: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Active Promotions count."
                outOfStockCount: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Out of Stock count."
                totalRetailStores: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Total Retail Stores count."
                totalAssortments: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Total Store Assortments count."
                totalStoreProducts: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Total Store Products count."
                totalTactics: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Total Tactics count."
                totalAssortmentProducts: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Total Assortment Products count."

        get_related_records:
            description: "Retrieve list of detailed records of a specific type (contacts, visits, promotions, inventory, outOfStock, retailstores, assortments, storeproducts, tactics, assortmentproducts) for the current Account."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent executing the request."
                    is_required: True
                actionType: string
                    description: "The type of action to perform."
                    is_required: True
                accountId: string
                    description: "The associated Account ID."
                    is_required: True
                recordType: string
                    description: "Type of records to retrieve: 'contacts', 'visits', 'promotions', 'inventory', 'outOfStock', 'retailstores', 'assortments', 'storeproducts', 'tactics', 'assortmentproducts'."
                    is_required: True
            outputs:
                records: list[object]
                    complex_data_type_name: "@apexClassType/c__Agent_Response$RecordInfo"
                    description: "List of related records containing name, status, owner, and lastModified."
                    is_displayable: True

        get_promotion_products:
            description: "Retrieve eligible products associated with a promotion using its ID or Name."
            target: "apex://Agent_Global_Handler"
            inputs:
                domain: string
                    description: "The domain 'Account'."
                    is_required: True
                actionType: string
                    description: "Set to 'getProducts'."
                    is_required: True
                promotionId: string
                    description: "The ID or name of the promotion (e.g. P-00000950) to fetch products for."
                    is_required: True
            outputs:
                message: string
                    description: "Markdown list of eligible product names."
                    is_displayable: True

        get_order_summary:
            description: "Retrieve order history summary, buying insights, phase breakdown, and recent orders for a given Account."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent executing the request."
                    is_required: True
                actionType: string
                    description: "The type of action to perform."
                    is_required: True
                accountId: string
                    description: "The associated Account ID."
                    is_required: True
            outputs:
                totalOrders: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Total number of historical orders."
                totalSpend: object
                    complex_data_type_name: "lightning__numberType"
                    description: "Total historical spend across all orders."
                buyingInsight: string
                    description: "AI-generated buying insight summary: top products by frequency, most saleable product."
                    is_displayable: True
                phaseBreakdown: string
                    description: "Order value breakdown by phase."
                    is_displayable: True
                recentOrders: string
                    description: "Formatted list of recent orders with details."
                    is_displayable: True

        get_visit_orders:
            description: "Retrieve order history summary, buying insights, phase breakdown, and recent orders for a given Visit ID."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent executing the request."
                    is_required: True
                actionType: string
                    description: "The type of action to perform."
                    is_required: True
                visitId: string
                    description: "The associated Visit ID."
                    is_required: True
            outputs:
                totalOrders: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Total number of orders associated with the visit."
                totalSpend: object
                    complex_data_type_name: "lightning__numberType"
                    description: "Total spend across those orders."
                buyingInsight: string
                    description: "AI-generated buying insight summary: top products by frequency, most saleable product."
                    is_displayable: True
                phaseBreakdown: string
                    description: "Order value breakdown by phase."
                    is_displayable: True
                recentOrders: string
                    description: "Formatted list of recent orders with details."
                    is_displayable: True

        get_order_items:
            description: "Retrieve product line items for a specific CG Cloud Order."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent executing the request."
                    is_required: True
                actionType: string
                    description: "The type of action to perform."
                    is_required: True
                orderId: string
                    description: "The CG Cloud Order ID."
                    is_required: True
            outputs:
                itemCount: object
                    complex_data_type_name: "lightning__integerType"
                    description: "Total number of line items."
                itemsSummary: string
                    description: "Formatted text summary of all line items."
                    is_displayable: True

        update_order_notes:
            description: "Update delivery notes and/or invoice notes on a specific CG Cloud Order by its ID or Name/Number."
            target: "apex://Agent_Global_Handler"
            require_user_confirmation: True
            inputs:
                agentName: string
                    description: "The name of the agent executing the request."
                    is_required: True
                actionType: string
                    description: "The type of action to perform."
                    is_required: True
                orderIdentifier: string
                    description: "The Salesforce Order ID or Order Name/Number (e.g., O-01159) to update."
                    is_required: True
                deliveryNote: string
                    description: "The new delivery note text. Optional."
                invoiceNote: string
                    description: "The new invoice note text. Optional."
            outputs:
                success: boolean
                    description: "Whether the update was successful."
                message: string
                    description: "Success or error message."
                    is_displayable: True

        get_store_brief:
            description: "Get store brief data including order totals, top products, active promotions, and open tasks."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent executing the request."
                    is_required: True
                actionType: string
                    description: "The type of action to perform."
                    is_required: True
                visitId: string
                    description: "The current Visit ID."
                    is_required: True
                accountId: string
                    description: "High level account contextual ID."
                    is_required: True
            outputs:
                summary: string
                    description: "Formatted markdown store brief."
                    is_displayable: True

        suggest_products:
            description: "Get product recommendations for the active store based on catalog gaps and order history."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent executing the request."
                    is_required: True
                actionType: string
                    description: "The type of action to perform."
                    is_required: True
                accountId: string
                    description: "The associated Account ID."
                    is_required: True
            outputs:
                recommendations: string
                    description: "Formatted list of recommended products."
                    is_displayable: True

        generate_visit_summary:
            description: "Collect visit execution metrics and return a formatted visit report."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent executing the request."
                    is_required: True
                actionType: string
                    description: "The type of action to perform."
                    is_required: True
                visitId: string
                    description: "The current Visit ID."
                    is_required: True
            outputs:
                visitSummary: string
                    description: "Generated visit summary text."
                    is_displayable: True

        update_visit:
            description: "Update fields on the current Visit record. Requires user confirmation."
            target: "apex://Agent_Global_Handler"
            require_user_confirmation: True
            inputs:
                agentName: string
                    description: "The name of the agent executing the request."
                    is_required: True
                actionType: string
                    description: "The type of action to perform."
                    is_required: True
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
                status: string
                    description: "New status value (e.g. InProgress, Completed, Canceled). Optional."
                notes: string
                    description: "Representative notes to append to the visit. Optional."
                startTime: object
                    complex_data_type_name: "lightning__dateTimeStringType"
                    description: "Actual start date/time. Optional."
                endTime: object
                    complex_data_type_name: "lightning__dateTimeStringType"
                    description: "Actual end date/time. Optional."
                ownerName: string
                    description: "Name of the user to assign the visit. Optional."
                ownerId: string
                    description: "Record ID of the user to assign the visit. Optional."
                ownerAlias: string
                    description: "Alias of the user to assign the visit. Optional."
                ownerProfileName: string
                    description: "Profile Name of the user to assign the visit. Optional."
            outputs:
                success: boolean
                    description: "True if the visit was successfully updated."
                message: string
                    description: "Result status message."
                    is_displayable: True

        search_users:
            description: "Search for users by name."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent executing the request."
                    is_required: True
                actionType: string
                    description: "The type of action to perform."
                    is_required: True
                searchQuery: string
                    description: "The name of the user to search for."
                    is_required: True
            outputs:
                users: list[object]
                    complex_data_type_name: "@apexClassType/c__Agent_Response$UserOption"
                    description: "List of matching users containing name, userId, alias, and profileName."
                    is_displayable: True

        get_account_visits:
            description: "Retrieve list of Visit records for the active Account."
            target: "apex://Agent_Global_Handler"
            inputs:
                actionType: string
                    description: "The type of action to perform: 'getAccountVisits'."
                    is_required: True
                accountId: string
                    description: "The Account ID."
                    is_required: True
                searchQuery: string
                    description: "The search query (should be empty for account visits)."
            outputs:
                visits: list[object]
                    complex_data_type_name: "@apexClassType/c__Agent_Response$VisitOption"
                    description: "List of visits for the Account."

        get_oos_visits:
            description: "Retrieve list of Visit records with out-of-stock issues for the active Account."
            target: "apex://Agent_Global_Handler"
            inputs:
                actionType: string
                    description: "The type of action to perform: 'getOosVisits'."
                    is_required: True
                accountId: string
                    description: "The Account ID."
                    is_required: True
                searchQuery: string
                    description: "The search query (should be empty for OOS visits)."
            outputs:
                visits: list[object]
                    complex_data_type_name: "@apexClassType/c__Agent_Response$VisitOption"
                    description: "List of visits with out-of-stock issues."

subagent off_topic:
    label: "Off Topic"
    description: "Redirect conversation to relevant topics when user request goes off-topic."

    reasoning:
        instructions: ->
            | You should explain that you are specialized in Salesforce Visit Intelligence, analyzing Visit records, associated Accounts, and related records (Visits, Tasks, Promotions, Out-of-Stock, Retail Stores, Assortments, Store Products, Tactics, and Order History).
            | Do not answer general knowledge questions. Redirect the conversation to your capabilities.

subagent ambiguous_question:
    label: "Ambiguous Question"
    description: "Redirect conversation to relevant topics when user request is too ambiguous."

    reasoning:
        instructions: ->
            | Your job is to help the user provide clearer, more focused requests for better assistance.
            | Ask the user if they would like to see a summary of the current Account, or check details of specific related records.

subagent clear_context:
    description: "Utility subagent to clear the active Visit and Account context variables before selecting another visit."
    before_reasoning:
        set @variables.visitId = ""
        set @variables.accountId = ""
        set @variables.accountName = ""
        set @variables.visitStatus = ""
        set @variables.visitDate = ""
        set @variables.assignedUser = ""
        set @variables.visitSummaryText = ""
        set @variables.lastRecordId = ""
        set @variables.tempCreateVisitWrapper = None
        set @variables.activeSubagent = "visit_intelligence"
        transition to @subagent.agent_router
    reasoning:
        instructions: |
            Clearing context and returning to router.

subagent update_visit_lwc:
    label: "Update Visit LWC"
    description: "Update the status, owner, notes, start time, or end time of the current visit using Custom LWC forms for non-field reps."
    before_reasoning:
        set @variables.activeSubagent = "update_visit_lwc"
        set @variables.tempCreateVisitWrapper = None
    reasoning:
        instructions: |
            You are now in the Update Visit LWC subagent.
            Your goal is to execute the appropriate record update action using custom LWC inputs.
            Under all circumstances, do NOT output any option menus, text choice prompts, field lists, or text descriptions of status options/fields to the user. All fields and choices must be rendered strictly by the LWC UI.

            SECTION 1: DETERMINING THE DIRECT ACTION OR GENERAL UPDATE FLOW
            Analyze the user's latest query or the active context:
            - If the user explicitly asks to update a specific field:
              * status -> Call the `update_visit_status` action to render the status update LWC form and collect `statusWrapper` value from the user.
              * owner/assignee -> Call the `update_visit_owner` action to render the owner assignment LWC form and collect `ownerWrapper` value from the user.
              * notes -> Call the `update_visit_notes` action to render the notes entry form and collect `notes` value from the user.
              * start time -> Call the `update_visit_start_time` action to render the start time calendar picker LWC form and collect `plannedStartTimeWrapper` value from the user.
              * end time -> Call the `update_visit_end_time` action to render the end time calendar picker LWC form and collect `plannedEndTimeWrapper` value from the user.
            - For general updates (if the user's latest message or query is "7", "Update Visit", "Update Visit Information", "General Update", or any generic/ambiguous request that does not specify a single field):
              * First step: You MUST call the `get_visit_for_update` action with `visitId = @variables.visitId` and `domain = "Visit"` to load the full-form wrapper. Do NOT output any options menu, list of choices, or text prompts asking the user what field they want to update.
              * Second step: Once `get_visit_for_update` completes successfully, call the `update_visit_record` action to render the full-form LWC editor and collect `createVisitWrapper` value from the user.
            - GUARD: You are strictly forbidden from calling `update_visit_record` unless `get_visit_for_update` has already run successfully and returned success = True, and `createVisitWrapper` is populated with actual form data (not placeholder or empty values like '...' or '__user_input__').

            SECTION 2: LWC SLOT-FILLING AND MANUAL INPUT TRANSITION
            - Since the LWC parameters (statusWrapper, ownerWrapper, plannedStartTimeWrapper, plannedEndTimeWrapper, createVisitWrapper) are slot-filled (using ...), the platform will prompt the user to fill the form in the chat.
            - If the user types "manual input" in the chat box while they are viewing the LWC form:
              * Do NOT transition to another action or subagent.
              * Populate the required input wrapper parameter of the active action with the manual input dummy indicator:
                - If Status update -> set statusWrapper.statusValue = "manual input".
                - If Owner update -> set ownerWrapper.ownerName = "manual input".
                - If Start Time update -> set plannedStartTimeWrapper.dateTimeValue = "1900-01-01T00:00:00Z".
                - If End Time update -> set plannedEndTimeWrapper.dateTimeValue = "1900-01-01T00:00:00Z".
              * Once the action returns the conversational choices prompt text, immediately transition to the Update Visit Text subagent using go_to_update_visit_text.

            SECTION 3: RETURN ON SUCCESS AND FAILURE HANDLING
            - If any update action (including `update_visit_record`) returns success = True:
              * Run get_visit to load the latest visit details.
              * Set @variables.tempIsUpdated = True
              * Print a success message (e.g., "Perfect! I've updated the visit status to Completed ✅").
              * Print the updated visit details in a clean markdown table (Columns: "Detail" and "Value") with emojis:
                - Account: {!@variables.accountName} 🏪
                - Visit Date: {!@variables.visitDate} 📅
                - Visit Status: {!@variables.visitStatus} 🔖
                - Assigned User: {!@variables.assignedUser} 👤
              * Transition back to the main dashboard using go_to_intelligence.
            - If `get_visit_for_update` or any update action returns success = False (other than the manual input fallback), surface the specific error message verbatim and re-prompt the user for the missing inputs, ask them to try again, or type "manual input" to route to the manual input fallback (go_to_update_visit_text).
            - If the action execution fails (e.g. shows a red cross or throws a platform/binding error like FIELD_INTEGRITY_EXCEPTION), do NOT print a success message, do NOT show the updated details table, and do NOT transition. Surface the specific error message, and if it recommends resetting, ask the user to click the "Reset" button at the top right of the Preview Settings.

        actions:
            get_visit_for_update: @actions.get_visit_for_update
                with agentName = "VisitIntelligence"
                with actionType = "get_visit_for_update"
                with domain = "Visit"
                with visitId = @variables.visitId
                set @variables.tempCreateVisitWrapper = @outputs.createVisitWrapper

            get_visit: @actions.get_visit_details
                with recordId = @variables.visitId
                set @variables.accountId = @outputs.accountId
                set @variables.accountName = @outputs.accountName
                set @variables.visitStatus = @outputs.visitStatus
                set @variables.visitDate = @outputs.visitDate
                set @variables.assignedUser = @outputs.assignedUser

            update_visit_record: @actions.update_visit_record
                available when @variables.tempCreateVisitWrapper is not None
                with agentName = "VisitIntelligence"
                with actionType = "update_visit_record"
                with domain = "Visit"
                with visitId = @variables.visitId
                with createVisitWrapper = ...

            update_visit_status: @actions.update_visit_status
                with agentName = "VisitIntelligence"
                with actionType = "update_visit_status"
                with visitId = @variables.visitId
                with statusWrapper = ...

            update_visit_owner: @actions.update_visit_owner
                with agentName = "VisitIntelligence"
                with actionType = "update_visit_owner"
                with visitId = @variables.visitId
                with ownerWrapper = ...

            update_visit_notes: @actions.update_visit_notes
                with agentName = "VisitIntelligence"
                with actionType = "update_visit_notes"
                with visitId = @variables.visitId
                with notes = ...

            update_visit_start_time: @actions.update_visit_start_time
                with agentName = "VisitIntelligence"
                with actionType = "update_visit_start_time"
                with visitId = @variables.visitId
                with plannedStartTimeWrapper = ...
                with plannedStartTimeStr = ...

            update_visit_end_time: @actions.update_visit_end_time
                with agentName = "VisitIntelligence"
                with actionType = "update_visit_end_time"
                with visitId = @variables.visitId
                with plannedEndTimeWrapper = ...
                with plannedEndTimeStr = ...

            go_to_update_visit_text: @utils.transition to @subagent.update_visit_text
            go_to_intelligence: @utils.transition to @subagent.visit_intelligence

    actions:

        get_visit_for_update:
            description: "Retrieve current visit details formatted for full-form update."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                domain: string
                    description: "The domain parameter."
                    is_required: True
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
            outputs:
                success: boolean
                    description: "True if the load was successful."
                message: string
                    description: "Outcome message."
                createVisitWrapper: object
                    complex_data_type_name: "c__createVisitWrapperType"
                    description: "The loaded visit details form data."

        update_visit_record:
            description: "Validate fields and update the Visit record. The createVisitWrapper parameter must be populated using the form input."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                domain: string
                    description: "The domain parameter."
                    is_required: True
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
                createVisitWrapper: object
                    complex_data_type_name: "c__createVisitWrapperType"
                    description: "The updated visit details form data."
                    is_required: False
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True if the Visit was successfully updated."
                message: string
                    description: "Status message or error message from Salesforce."

        update_visit_status:
            description: "Update the status of the current Visit. Call this action immediately with only the visitId when the user requests or selects to update the status, and the platform will render the input form UI."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
                statusWrapper: object
                    complex_data_type_name: "c__visitStatusWrapperType"
                    description: "The new status of the visit (e.g., InProgress, Completed, Canceled, Abandoned, Planned)."
                    is_required: False
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True if the status was successfully updated."
                message: string
                    description: "Result status message."
                    is_displayable: True

        update_visit_owner:
            description: "Assign the current Visit record to a different user. Call this action immediately with only the visitId when the user requests or selects to update the owner/assignee, and the platform will render the input form UI."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
                ownerWrapper: object
                    complex_data_type_name: "c__visitOwnerWrapperType"
                    description: "The new owner of the visit."
                    is_required: False
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True if the assignee was successfully updated."
                message: string
                    description: "Result status message."
                    is_displayable: True

        update_visit_notes:
            description: "Update or append notes to the current Visit record. Call this action immediately with only the visitId when the user requests or selects to update the notes, and the platform will render the input form UI."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
                notes: string
                    description: "The notes text to append to the visit."
                    is_required: True
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True if the notes were successfully updated."
                message: string
                    description: "Result status message."
                    is_displayable: True

        update_visit_start_time:
            description: "Update the planned start date and time of the current Visit. Call this action immediately with only the visitId when the user requests or selects to update the start time/date, and the platform will render the calendar picker form UI."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
                plannedStartTimeWrapper: object
                    complex_data_type_name: "c__visitDateTimeWrapperType"
                    description: "The new planned start date and time."
                    is_required: False
                    is_user_input: True
                plannedStartTimeStr: string
                    description: "The new planned start date and time as a text string."
                    is_required: False
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True if the planned start time was successfully updated."
                message: string
                    description: "Result status message."
                    is_displayable: True

        update_visit_end_time:
            description: "Update the planned end date and time of the current Visit. Call this action immediately with only the visitId when the user requests or selects to update the end time/date, and the platform will render the calendar picker form UI."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
                plannedEndTimeWrapper: object
                    complex_data_type_name: "c__visitDateTimeWrapperType"
                    description: "The new planned end date and time."
                    is_required: False
                    is_user_input: True
                plannedEndTimeStr: string
                    description: "The new planned end date and time as a text string."
                    is_required: False
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True if the planned end time was successfully updated."
                message: string
                    description: "Result status message."
                    is_displayable: True

        get_visit_details:
            description: "Retrieve details of the current Visit record and its associated Account."
            target: "flow://Get_Visit_Details"
            inputs:
                recordId: string
                    description: "The ID of the Visit record."
                    is_required: True
            outputs:
                recordId: string
                    description: "The ID of the Visit record."
                accountId: string
                    description: "The associated Account ID."
                accountName: string
                    description: "The associated Account Name."
                visitStatus: string
                    description: "The Visit Status."
                visitDate: string
                    description: "The Visit Date."
                assignedUser: string
                    description: "The Assigned User."


subagent update_visit_text:
    label: "Update Visit Text"
    description: "Update the status, owner, notes, start time, or end time of the current visit conversationally using plain text inputs."
    before_reasoning:
        set @variables.activeSubagent = "update_visit_text"
    reasoning:
        instructions: |
            You are now in the Update Visit Text subagent.
            Your goal is to update details (status, owner, notes, start time, or end time) of the current Visit (ID: {!@variables.visitId}) conversationally using text inputs.

            SECTION 1: DISPATCH UPDATE ACTION
            - If the user has just transitioned here due to manual input, or if their message does not specify a field to update, first present the fields that can be updated in a numbered list:
              "Please select a field to update:
              1. Status (currently: {!@variables.visitStatus})
              2. Owner (currently: {!@variables.assignedUser})
              3. Notes
              4. Start Time (currently: {!@variables.visitDate})
              5. End Time"
            - If the user selects a field or option from the menu, call the corresponding conversational mobile action:
              * "Status" / Option 1 -> Call update_visit_status_mobile with only visitId.
              * "Owner" / Option 2 -> Call update_visit_owner_mobile with only visitId.
              * "Notes" / Option 3 -> Call update_visit_notes_mobile with only visitId.
              * "Start Time" / Option 4 -> Call update_visit_start_time_mobile with only visitId.
              * "End Time" / Option 5 -> Call update_visit_end_time_mobile with only visitId.
            - If they provide both the field and the value in the same request (e.g., "change status to completed", "assign to Siri FieldRep"), map the field and pass the value directly to the corresponding action (e.g., `status = "completed"` or `ownerName = "Siri FieldRep"`).

            SECTION 2: RETURN ON SUCCESS
            - If any update action returns success = True:
              * Run get_visit to load the latest visit details.
              * Set @variables.tempIsUpdated = True
              * Print a success message (e.g., "Perfect! I've updated the visit details conversationally ✅").
              * Print the updated visit details in a clean markdown table (Columns: "Detail" and "Value") with emojis:
                - Account: {!@variables.accountName} 🏪
                - Visit Date: {!@variables.visitDate} 📅
                - Visit Status: {!@variables.visitStatus} 🔖
                - Assigned User: {!@variables.assignedUser} 👤
              * Transition back to the main dashboard using go_to_intelligence.
            - If any update action returns success = False, print the returned message verbatim and capture their subsequent text input.

        actions:
            get_visit: @actions.get_visit_details
                with recordId = @variables.visitId
                set @variables.accountId = @outputs.accountId
                set @variables.accountName = @outputs.accountName
                set @variables.visitStatus = @outputs.visitStatus
                set @variables.visitDate = @outputs.visitDate
                set @variables.assignedUser = @outputs.assignedUser

            update_visit_status_mobile: @actions.update_visit_status_mobile_action
                with agentName = "VisitIntelligence"
                with actionType = "update_visit_status_mobile_action"
                with visitId = @variables.visitId
                with status = ...

            update_visit_owner_mobile: @actions.update_visit_owner_mobile_action
                with agentName = "VisitIntelligence"
                with actionType = "update_visit_owner_mobile_action"
                with visitId = @variables.visitId
                with ownerName = ...
                with suggestions = @variables.tempOwnerSuggestions
                set @variables.tempOwnerSuggestions = @outputs.suggestions

            update_visit_notes_mobile: @actions.update_visit_notes_mobile_action
                with agentName = "VisitIntelligence"
                with actionType = "update_visit_notes_mobile_action"
                with visitId = @variables.visitId
                with notes = ...

            update_visit_start_time_mobile: @actions.update_visit_start_time_mobile_action
                with agentName = "VisitIntelligence"
                with actionType = "update_visit_start_time_mobile_action"
                with visitId = @variables.visitId
                with plannedStartTimeStr = ...

            update_visit_end_time_mobile: @actions.update_visit_end_time_mobile_action
                with agentName = "VisitIntelligence"
                with actionType = "update_visit_end_time_mobile_action"
                with visitId = @variables.visitId
                with plannedEndTimeStr = ...

            go_to_intelligence: @utils.transition to @subagent.visit_intelligence

    actions:

        update_visit_status_mobile_action:
            description: "Update the status of the current Visit conversationally."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
                status: string
                    description: "The new status of the visit or choice number."
                    is_required: True
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True if the update was successful."
                message: string
                    description: "Result status message."
                    is_displayable: True

        update_visit_owner_mobile_action:
            description: "Update the owner of the current Visit conversationally."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
                ownerName: string
                    description: "The new owner name, username, or choice number."
                    is_required: True
                    is_user_input: True
                suggestions: string
                    description: "Suggestions list"
                    is_required: False
                    is_user_input: False
            outputs:
                success: boolean
                    description: "True if the update was successful."
                message: string
                    description: "Result status message."
                    is_displayable: True
                suggestions: string
                    description: "Matched IDs if ambiguous."

        update_visit_notes_mobile_action:
            description: "Update the representative notes of the current Visit conversationally."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
                notes: string
                    description: "The notes text to append to the visit."
                    is_required: True
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True if the update was successful."
                message: string
                    description: "Result status message."
                    is_displayable: True

        update_visit_start_time_mobile_action:
            description: "Update the planned start date and time of the current Visit conversationally."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
                plannedStartTimeStr: string
                    description: "The new planned start date and time."
                    is_required: True
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True if the update was successful."
                message: string
                    description: "Result status message."
                    is_displayable: True

        update_visit_end_time_mobile_action:
            description: "Update the planned end date and time of the current Visit conversationally."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                visitId: string
                    description: "The active Visit record ID."
                    is_required: True
                plannedEndTimeStr: string
                    description: "The new planned end date and time."
                    is_required: True
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True if the update was successful."
                message: string
                    description: "Result status message."
                    is_displayable: True

        get_visit_details:
            description: "Retrieve details of the current Visit record and its associated Account."
            target: "flow://Get_Visit_Details"
            inputs:
                recordId: string
                    description: "The ID of the Visit record."
                    is_required: True
            outputs:
                recordId: string
                    description: "The ID of the Visit record."
                accountId: string
                    description: "The associated Account ID."
                accountName: string
                    description: "The associated Account Name."
                visitStatus: string
                    description: "The Visit Status."
                visitDate: string
                    description: "The Visit Date."
                assignedUser: string
                    description: "The Assigned User."


subagent visit_activities:
    label: "Visit Activities"
    description: "Manage and retrieve planned activities, questions, and surveys for the selected visit, and check answered or pending questions."
    before_reasoning:
        set @variables.activeSubagent = "visit_activities"

    reasoning:
        instructions: ->
            if @variables.accountId != "":

                | Context loaded for Account: "{!@variables.accountName}" (Visit ID: {!@variables.visitId}).
                | Status: {!@variables.visitStatus}, Date: {!@variables.visitDate}, User: {!@variables.assignedUser}.
                |
                | You must process the user's message using the following strict priority guidelines:
                |
                | SECTION 1: DIRECT FEATURE REQUESTS
                | - Check if the user's message directly requests a specific feature or option:
                |   * "View today's activities or surveys" / "show activities" / "visit activities" -> Call @actions.get_visit_activities with questionOrSurveyFilter = "all"
                |   * "View today's questions" / "activity questions" / "show questions" -> Call @actions.get_visit_activities with questionOrSurveyFilter = "question"
                |   * "View today's surveys" / "activity surveys" / "show surveys" -> Call @actions.get_visit_activities with questionOrSurveyFilter = "survey"
                |   * "See answered or pending questions" / "completed questions" / "unanswered questions" -> Call @actions.get_visit_jobs_status with statusFilter mapped accordingly ("answered", "pending", "all") and questionOrSurveyFilter = "all"
                |   * "See answered or pending surveys" / "completed surveys" / "unanswered surveys" -> Call @actions.get_visit_jobs_status with statusFilter mapped accordingly ("answered", "pending", "all") and questionOrSurveyFilter = "survey"
                |   * "Go back" / "exit activities" / "Return to options" -> Transition to @subagent.visit_intelligence
                |   * "Switch to another visit" / "change visit" / "reset context" -> Call @actions.switch_visit
                |
                | SECTION 2: GREETING & DEFAULT DASHBOARD DISPLAY
                | - If the user's message is a generic greeting, request, or when first entering this subagent (e.g. when transitioning from the "Visit Activities" option using any number like 6 or 9, or by name):
                |   1. Display the Visit Details in a clean markdown table (Columns: "Detail" and "Value") with emojis:
                |      * Account: {!@variables.accountName} 🏪
                |      * Visit Date: {!@variables.visitDate} 📅
                |      * Visit Status: {!@variables.visitStatus} 🔖
                |   2. Print the heading: "Planned Activities for {!@variables.accountName} Visit"
                |   3. Call @actions.get_visit_activities with questionOrSurveyFilter = "all" to retrieve and present the planned activities.
                |
                | SECTION 3: MENU SELECTION & DYNAMIC OPTION MAPPING
                | - When the user selects an option by entering a number (e.g. "1", "2") or typing a label, map it dynamically:
                |   1. Extract the text label of the numbered option corresponding to the user's input from the last message.
                |   2. Execute the action for that option text:
                |      * View today's activities or surveys / planned activities / Visit Activities / 📝 Visit Activities / 📝 Visit Activities (Check surveys, checklists, or questions) / 📝 Visit Activities (Surveys/Checklists) / 📝 Visit Activities (Surveys & Checklists) -> Call @actions.get_visit_activities with questionOrSurveyFilter = "all"
                |      * View today's questions / activity questions / planned questions -> Call @actions.get_visit_activities with questionOrSurveyFilter = "question"
                |      * View today's surveys / activity surveys / planned surveys -> Call @actions.get_visit_activities with questionOrSurveyFilter = "survey"
                |      * See answered or pending questions / completed questions / unanswered questions -> Call @actions.get_visit_jobs_status with statusFilter = "all" and questionOrSurveyFilter = "all"
                |      * Check all questions and survey statuses / statuses / statuses of questions -> Call @actions.get_visit_jobs_status with statusFilter = "all" and questionOrSurveyFilter = "all"
                |      * Switch to another visit / change visit / reset context -> Call @actions.switch_visit
                |      * Go back / exit activities / Return to options -> Transition to @subagent.visit_intelligence
                |   3. FALLBACK MAPPING FOR DIRECT NUMBER INPUTS:
                |      - If the user was shown the Planned Activities view (where Option 1 is "See answered or pending questions"):
                |        * "1" or "2" -> Call @actions.get_visit_jobs_status with statusFilter = "all" and questionOrSurveyFilter = "all"
                |        * "3" -> Call @actions.switch_visit
                |        * "4" -> Transition to @subagent.visit_intelligence
                |      - If the user was shown the Questions/Surveys Status view (where Option 1 is "View today's activities or surveys"):
                |        * "1" -> Call @actions.get_visit_activities with questionOrSurveyFilter = "all"
                |        * "2" -> Call @actions.switch_visit
                |        * "3" -> Transition to @subagent.visit_intelligence
                |      - If the user inputs "6" or "9" or maps to "Visit Activities" from the parent agent menu, call @actions.get_visit_activities with questionOrSurveyFilter = "all".
                |   4. Always render the hardcoded Next Steps menu (described in Section 4) at the end of the response.
                |
                | SECTION 4: SPECIFIC FORMATTING & PRESENTATION RULES
                |
                | --- WEB FORMATTING (channelType == "web") ---
                | - Global Style: Give all responses "character" by using clear emojis, bold headings, and organized bullet points or markdown tables.
                | - Activities & Questions/Surveys Table (Web):
                |   * Display the list of activities. For each activity:
                |     * Separately group and display the items into two sections: "Questions" and "Surveys".
                |     * Under "Questions" (only if questions exist), present a clean table with columns: | 📝 Question | ⚠️ Mandatory? |
                |     * Under "Surveys" (only if surveys exist), present a clean table with columns: | 📝 Survey | ⚠️ Mandatory? |
                |     * In the "Mandatory?" column: If `mandatory` is True, print "Yes ⚠️". If False, print "No".
                |     * Do NOT print the description, type, or data type columns.
                | - Jobs & Surveys Status Display (Web):
                |   * Separately group and display the status of Questions and Surveys into two distinct sections:
                |     1. "Questions Status":
                |        * Present a clean table showing detailed rows for each individual question (where jobType is 'Question') with headers:
                |          | 📝 Question | 🏷️ Description | ✅ Answered? | 💬 Value / Answer |
                |        * Under "Answered?", if `isDone` is True, print "Yes". If False, print "No".
                |     2. "Surveys Status":
                |        * You MUST group all status records of type 'Survey' by their survey name (questionName) and display a single aggregated table.
                |        * The table columns MUST be EXACTLY: | 📝 Survey | 📦 Products Checked / Total | 📊 Progress |
                |        * Do NOT use columns like "Description", "Answered?", "Value", or "Answer".
                |        * For each unique survey name, calculate:
                |          - Checked records: The count of status records with this name where `isDone` is True.
                |          - Total records: Read the `totalProductCount` value from any record of this survey (do NOT count the number of fallback/pending records, just use the `totalProductCount` value directly as the denominator).
                |        * Format each row exactly as: `| [Survey Name] | [Checked records] / [Total records] | [Percentage]% |`.
                |
                | --- MOBILE FORMATTING (channelType == "mobile") ---
                | - Strict Number-Based Listing Rule: Every retrieved activity, planned question, survey, status, and job description MUST be presented as a sequentially numbered list starting at 1. Tables or bullet points are strictly forbidden for lists.
                | - Activities & Questions/Surveys Listing (Mobile):
                |   * Display the list of activities. For each activity:
                |     * Separately group and display the items into two sections: "Questions" and "Surveys".
                |     * Under "Questions" (only if questions exist), present them strictly as a sequentially numbered list starting at 1, with format: `[Question Text] - Mandatory: [Yes ⚠️ / No]`.
                |     * Under "Surveys" (only if surveys exist), present them strictly as a sequentially numbered list starting at 1, with format: `[Survey Name] - Mandatory: [Yes ⚠️ / No]`.
                |     * Do NOT print description or data type columns.
                | - Jobs & Surveys Status Display (Mobile):
                |   * Separately group and display the status of Questions and Surveys into two distinct sections:
                |     1. "Questions Status":
                |        * Present them strictly as a sequentially numbered list starting at 1, with format: `[Question Name] (Description: [Description]) - Answered: [Yes/No] (Answer: [Value/Answer])`.
                |     2. "Surveys Status":
                |        * Group all status records of type 'Survey' by their survey name (questionName) and display them strictly as a sequentially numbered list starting at 1.
                |        * For each unique survey name, calculate:
                |          - Checked records: The count of status records with this name where `isDone` is True.
                |          - Total records: Read the `totalProductCount` value from any record of this survey.
                |        * Format each row exactly as a numbered list item: `[Survey Name] - Products Checked: [Checked records]/[Total records] - Progress: [Percentage]%`.
                |
                | --- SHARED FORMATTING (Both Web and Mobile) ---
                | - Empty Activities/Surveys Handling:
                |   * If the activities list returned by get_visit_activities is empty or null, output: "There are no planned activities, questions, or surveys for this visit."
                | - Dynamic Headings based on Filter:
                |   * If `questionOrSurveyFilter` is "question", refer to the output as "planned questions" or "questions".
                |   * If `questionOrSurveyFilter` is "survey", refer to the output as "planned surveys" or "surveys".
                |   * Otherwise, refer to the output as "planned activities" or "activities and surveys".
                | - Summary Counts: Below the tables/lists, print the summary counts ONLY for Questions:
                |     * Summary:
                |       - Total Questions: [Total count of questions]
                |       - ✅ Answered: [Count of completed questions]
                |       - ⏳ Pending: [Count of pending questions]
                | - Next Steps Choices Rendering:
                |   * Always render a next steps menu at the bottom of the response. Use the emoji 🔄 followed by the text "**Next Steps** - What would you like to do next? Please select an option by number or type your choice:"
                |   * If the current view is showing the planned activities/surveys:
                |     1. **See answered or pending questions** - Check completed vs pending questions/surveys for the current visit.
                |     2. **Check all questions and survey statuses** - List all questions and surveys status for the current visit.
                |     3. **Switch to another visit** - Clear active visit context and select a different visit.
                |     4. **Go back** - Return to the main options selection.
                |   * If the current view is showing the questions/surveys status:
                |     1. **View today's activities or surveys** - View planned activities and surveys for the current visit.
                |     2. **Switch to another visit** - Clear active visit context and select a different visit.
                |     3. **Go back** - Return to the main options selection.
                |   * Conclude with a helpful prompt: "How can I assist you further?"
                | - Do NOT use show_command. Always compose response as direct text.
            else:
                | Visit details not loaded. Please select a visit first.

        actions:
            get_visit_activities: @actions.get_visit_activities
                description: "Retrieves planned activities, questions, and surveys associated with a visit based on its visit template."
                with agentName = "Visit_Intelligence"
                with actionType = "getActivities"
                with visitId = @variables.visitId
                with questionOrSurveyFilter = ...

            get_visit_jobs_status: @actions.get_visit_jobs_status
                description: "Retrieves completed (answered) or pending (unanswered) questions/surveys for the current visit."
                with agentName = "Visit_Intelligence"
                with actionType = "getJobsStatus"
                with visitId = @variables.visitId
                with statusFilter = ...
                with questionOrSurveyFilter = ...

            get_next_steps: @actions.get_next_steps
                description: "Get the next steps options for the user. Call this to present the selectable choices to the user as clickable choice buttons/cards."
                with agentName = "Visit_Intelligence"
                with actionType = "getNextSteps"
                with excludeOption = ...

            switch_visit: @utils.transition to @subagent.clear_context
                description: "Change, switch, or select another Visit or work on a different store."

            back_to_intelligence: @utils.transition to @subagent.visit_intelligence
                description: "Return to the main options selection."

    actions:
        get_visit_activities:
            description: "Retrieves activities, questions, and surveys associated with a visit based on its visit template."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                    is_required: True
                actionType: string
                    description: "The action to perform."
                    is_required: True
                visitId: string
                    description: "The ID of the Visit record."
                    is_required: True
                questionOrSurveyFilter: string
                    description: "Filter by type: all, question, survey."
            outputs:
                activities: list[object]
                    complex_data_type_name: "@apexClassType/c__Agent_Response$ActivityInfo"
                    description: "List of activities and questions/surveys associated with the visit template."

        get_visit_jobs_status:
            description: "Retrieves answered or pending visit jobs (questions/surveys) for a specific visit."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                    is_required: True
                actionType: string
                    description: "The action to perform."
                    is_required: True
                visitId: string
                    description: "The ID of the Visit record."
                    is_required: True
                statusFilter: string
                    description: "Filter by: all, answered, pending."
                questionOrSurveyFilter: string
                    description: "Filter by type: all, question, survey."
            outputs:
                jobs: list[object]
                    complex_data_type_name: "@apexClassType/c__Agent_Response$JobStatusInfo"
                    description: "List of matching visit jobs (questions/surveys) with answer status."

        get_next_steps:
            description: "Retrieve the next steps options to show to the user as clickable choice buttons/cards."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                    is_required: True
                actionType: string
                    description: "The action to perform."
                    is_required: True
                excludeOption: string
                    description: "The option label to exclude."
            outputs:
                itemDetails: list[object]
                    complex_data_type_name: "@apexClassType/c__Agent_Response$ItemDetail"
                    description: "List of next step options."
                    is_displayable: True

subagent create_visit:
    label: "Create Visit Agent"
    description: "Handle the creation of a new Visit record using the standard UI form. Only use if the user profile is NOT CGCloud_User_Profile."
    before_reasoning:
        set @variables.activeSubagent = "create_visit"

    reasoning:
        instructions: ->
            if @variables.visitId != "" and @variables.visitId is not None and @variables.visitId != "None":
                set @variables.activeSubagent = "visit_intelligence"
                set @variables.accountId = ""
                transition to @subagent.agent_router

            if @variables.visitId == "":
                | You are now in the Create Visit Agent.
                | Please call the create_visit_record action immediately to present the record creation form to the user.
                | Do NOT ask the user for any details in text. Let the form collect them.
                | Greet the user verbatim with: "I've opened the Create Visit form for you. Please fill in the details in the form that appears in the chat."
                |
                | If the user requests manual input or types "manual input" while they are in the Create Visit Agent:
                |   - Immediately transition to the Create Visit Mobile Agent (Manual Input Agent) using go_to_create_visit_mobile.
                |
                | If the create_visit_record action returns success = False, you MUST display the error message returned in the message output field verbatim: "Failed to create visit: [message]" and do NOT transition.

        actions:
            create_visit_record: @actions.create_visit_record
                with agentName = "VisitIntelligence"
                with actionType = "create_visit_record"
                description: "Validate fields and create a new Visit record."
                with createVisitWrapper = ...
                set @variables.visitId = @outputs.visitId
                set @variables.accountId = @outputs.accountId
                set @variables.visitStatus = @outputs.visitStatus
                set @variables.visitDate = @outputs.visitDate
                set @variables.assignedUser = @outputs.assignedUser

            go_to_create_visit_mobile: @utils.transition to @subagent.create_visit_mobile

    actions:
        get_current_user_profile:
            description: "Retrieve the current user's profile name."
            target: "apex://Agent_Global_Handler"
            inputs:
                domain: string
                    description: "The domain of execution. Must be GetCurrentUserProfile."
                    is_required: False
                actionType: string
                    description: "The action to perform. Must be getProfile."
                    is_required: False
            outputs:
                success: boolean
                    description: "True if the query was successful."
                profileName: string
                    description: "The name of the user profile."

        create_visit_record:
            description: "Validate fields and create a new Visit record. The visitData parameter must be populated using the form input."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                createVisitWrapper: object
                    complex_data_type_name: "c__createVisitWrapperType"
                    description: "The visit details form data containing Subject, Account, Planned Start, Place, and optional fields."
                    is_required: False
                    is_user_input: True
            outputs:
                success: boolean
                    description: "True if the Visit was successfully created."
                message: string
                    description: "Status message or error message from Salesforce."
                visitId: string
                    description: "The newly created Visit record ID."
                accountId: string
                    description: "The associated Account ID."
                visitStatus: string
                    description: "The Status of the new Visit."
                visitDate: string
                    description: "The Planned Start Date/Time."
                assignedUser: string
                    description: "The Assigned User."

subagent create_visit_mobile:
    label: "Create Visit Mobile Agent"
    description: "Handle the creation of a new Visit record using conversational multi-step flow. If the user is NOT a CGCloud_User_Profile, ONLY use this action if they explicitly request manual input."
    before_reasoning:
        set @variables.activeSubagent = "create_visit_mobile"

    reasoning:
        instructions: ->
            if @variables.visitId != "" and @variables.visitId is not None and @variables.visitId != "None":
                | Visit has been successfully created! 🎉
                |
                | Details:
                | - Account: {!@variables.tempAccountName}
                | - Place/Store: {!@variables.tempPlaceName}
                | - Visit Template: {!@variables.tempTemplateName}
                | - Subject: {!@variables.tempSubject}
                | - ID: {!@variables.visitId}
                |
                | I'm loading this visit and returning you to the main menu.
                set @variables.activeSubagent = "visit_intelligence"
                set @variables.accountId = ""
                set @variables.tempAccountId = ""
                set @variables.tempAccountName = ""
                set @variables.tempPlaceId = ""
                set @variables.tempPlaceName = ""
                set @variables.tempTemplateId = ""
                set @variables.tempTemplateName = ""
                set @variables.tempResponsibleUserId = ""
                set @variables.tempResponsibleUserName = ""
                set @variables.tempSubject = ""
                set @variables.tempPlannedStartTime = ""
                set @variables.tempPlannedStartTimeWrapper = None
                set @variables.isDateTimeSelected = False
                set @variables.tempAccountSuggestions = ""
                set @variables.tempPlaceSuggestions = ""
                set @variables.tempTemplateSuggestions = ""
                set @variables.tempOwnerSuggestions = ""
                transition to @subagent.agent_router

            if @variables.visitId == "":
                | You are in the Create Visit Agent. Your goal is to gather all inputs step-by-step. To ensure an optimal user experience, all prompts and choices MUST be processed conversationally in plain text chat (no input cards or forms allowed).
                |
                | Step 1: Prompt Account Name (Plain Text Chat)
                | If `tempAccountId` is empty:
                |   - Ask the user in plain text chat: "Please enter the Account name to create a visit."
                |   - Run `prompt_account_mobile` behind the scenes with the user's chat input to match it.
                |   - If the action returns `success = True`:
                |     * Set `tempAccountId = accountId` and `tempAccountName = accountName`.
                |     * Confirm to the user: "Matched Account: {!@variables.tempAccountName}".
                |   - If the action returns `success = False` and `tempIsSubmitted = True`:
                |     * Display the message/suggestions verbatim: "{!@variables.tempMessage}".
                |
                | Step 2: Prompt Place Name (Plain Text Chat)
                | If `tempAccountId` is NOT empty and `tempPlaceId` is empty:
                |   - Ask the user in plain text chat: "Please enter the Place/Store name for this visit."
                |   - Run `prompt_place_mobile` behind the scenes with the user's chat input to match it.
                |   - If the action returns `success = True`:
                |     * Set `tempPlaceId = placeId` and `tempPlaceName = placeName`.
                |     * Confirm to the user: "Matched Place: {!@variables.tempPlaceName}".
                |   - If the action returns `success = False` and `tempIsSubmitted = True`:
                |     * Display the message/suggestions verbatim: "{!@variables.tempMessage}".
                |
                | Step 3: Prompt Visit Template (Plain Text Chat)
                | If `tempPlaceId` is NOT empty and `tempTemplateId` is empty:
                |   - Ask the user in plain text chat: "Please enter the Visit Template name."
                |   - Run `prompt_template_mobile` behind the scenes with the user's chat input to match it.
                |   - If the action returns `success = True`:
                |     * Set `tempTemplateId = templateId` and `tempTemplateName = templateName`.
                |     * Confirm to the user: "Matched Template: {!@variables.tempTemplateName}".
                |   - If the action returns `success = False` and `tempIsSubmitted = True`:
                |     * Display the message/suggestions verbatim: "{!@variables.tempMessage}".
                |
                | Step 4: Prompt Subject (Plain Text Chat)
                | If `tempTemplateId` is NOT empty and `tempSubject` is empty:
                |   - Ask the user in plain text chat: "Please enter the Subject for this visit."
                |   - Set `tempSubject` to the user's chat response.
                |
                | Step 5: Prompt Date & Time (Plain Text Chat)
                | If `tempSubject` is NOT empty and `isDateTimeSelected` is False:
                |   - Ask the user in plain text chat: "Please enter the Planned Start Date and Time for this visit in day-month-year format (e.g. DD-MM-YYYY HH:MM)."
                |   - Run `prompt_final_details_mobile` behind the scenes with the user's chat input to match and parse it.
                |   - If the action returns `success = True` and `tempIsSubmitted = True`:
                |     * Set `tempPlannedStartTime = plannedStartTime` and `isDateTimeSelected = True`.
                |     * Confirm to the user: "{!@variables.tempMessage}".
                |   - If the action returns `success = False` and `tempIsSubmitted = True`:
                |     * Display the error message verbatim: "{!@variables.tempMessage}".
                |
                | Step 6: Save Visit Record (Direct Execution, No Card)
                | If `isDateTimeSelected` is True and `visitId` is empty:
                |   - Execute `create_visit_record_mobile` behind the scenes.
                |   - Pass the pre-matched variables directly:
                |     * `accountInput = tempAccountId`
                |     * `placeInput = tempPlaceId`
                |     * `templateInput = tempTemplateId`
                |     * `subject = tempSubject`
                |     * `plannedStartTime = tempPlannedStartTime`
                |   - If the action returns `success = False`, display the error message `message` verbatim so the user knows what failed, and do NOT clear all variables, just let the user adjust the incorrect inputs.

        actions:
            prompt_account_mobile: @actions.prompt_visit_mobile
                with agentName = "VisitIntelligence"
                with actionType = "prompt_visit_mobile"
                description: "Match and verify the Account name entered by the user."
                with accountInput = ...
                with suggestions = @variables.tempAccountSuggestions
                set @variables.tempAccountId = @outputs.accountId
                set @variables.tempAccountName = @outputs.accountName
                set @variables.tempMessage = @outputs.message
                set @variables.tempIsSubmitted = @outputs.isSubmitted
                set @variables.tempAccountSuggestions = @outputs.suggestions

            prompt_place_mobile: @actions.prompt_visit_mobile
                with agentName = "VisitIntelligence"
                with actionType = "prompt_visit_mobile"
                description: "Match and verify the Place/Store name entered by the user."
                with placeInput = ...
                with suggestions = @variables.tempPlaceSuggestions
                set @variables.tempPlaceId = @outputs.placeId
                set @variables.tempPlaceName = @outputs.placeName
                set @variables.tempMessage = @outputs.message
                set @variables.tempIsSubmitted = @outputs.isSubmitted
                set @variables.tempPlaceSuggestions = @outputs.suggestions

            prompt_template_mobile: @actions.prompt_visit_mobile
                with agentName = "VisitIntelligence"
                with actionType = "prompt_visit_mobile"
                description: "Match and verify the Visit Template name entered by the user."
                with templateInput = ...
                with suggestions = @variables.tempTemplateSuggestions
                set @variables.tempTemplateId = @outputs.templateId
                set @variables.tempTemplateName = @outputs.templateName
                set @variables.tempMessage = @outputs.message
                set @variables.tempIsSubmitted = @outputs.isSubmitted
                set @variables.tempTemplateSuggestions = @outputs.suggestions

            prompt_final_details_mobile: @actions.prompt_visit_mobile
                with agentName = "VisitIntelligence"
                with actionType = "prompt_visit_mobile"
                description: "Prompt the user for Date & Time conversationally."
                with matchedTemplate = @variables.tempTemplateName
                with plannedStartTimeStr = ...
                set @variables.tempPlannedStartTime = @outputs.plannedStartTimeStr
                set @variables.isDateTimeSelected = @outputs.isSubmitted
                set @variables.tempMessage = @outputs.message
                set @variables.tempIsSubmitted = @outputs.isSubmitted

            create_visit_record_mobile: @actions.create_visit_record_mobile
                with agentName = "VisitIntelligence"
                with actionType = "create_visit_record_mobile"
                description: "Create the final Visit record using the pre-matched inputs."
                with subject = @variables.tempSubject
                with accountInput = @variables.tempAccountId
                with placeInput = @variables.tempPlaceId
                with plannedStartTimeStr = @variables.tempPlannedStartTime
                with templateInput = @variables.tempTemplateId
                set @variables.visitId = @outputs.visitId
                set @variables.accountId = @outputs.accountId
                set @variables.visitStatus = @outputs.visitStatus
                set @variables.visitDate = @outputs.visitDate
                set @variables.assignedUser = @outputs.assignedUser
                set @variables.tempMessage = @outputs.message
                set @variables.tempIsSubmitted = @outputs.success

    actions:
        create_visit_record_mobile:
            description: "Validate fields and create a new Visit record using standard inputs."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                subject: string
                    description: "Subject of the visit"
                    is_required: False
                    is_user_input: False
                accountInput: string
                    description: "Account name or ID"
                    is_required: False
                    is_user_input: False
                placeInput: string
                    description: "Place/Store/Location name or ID"
                    is_required: False
                    is_user_input: False
                plannedStartTimeStr: string
                    description: "Planned start time of the visit"
                    is_required: False
                    is_user_input: False
                templateInput: string
                    description: "Visit Template name or ID"
                    is_required: False
                    is_user_input: False
            outputs:
                success: boolean
                    description: "True if the Visit was successfully created."
                message: string
                    description: "Status message or error message from Salesforce."
                    is_displayable: True
                visitId: string
                    description: "The newly created Visit record ID."
                accountId: string
                    description: "The associated Account ID."
                visitStatus: string
                    description: "The Status of the new Visit."
                visitDate: string
                    description: "The Planned Start Date/Time."
                assignedUser: string
                    description: "The Assigned User."

        prompt_visit_mobile:
            description: "Match and verify Account, Place, Template, or Date/Time fields conversationally."
            target: "apex://Agent_Global_Handler"
            inputs:
                agentName: string
                    description: "The name of the agent."
                actionType: string
                    description: "The action to perform."
                accountInput: string
                    description: "Enter Account Name"
                    is_required: False
                    is_user_input: False
                placeInput: string
                    description: "Enter Place / Store Name"
                    is_required: False
                    is_user_input: False
                templateInput: string
                    description: "Enter Visit Template Name"
                    is_required: False
                    is_user_input: False
                plannedStartTimeStr: string
                    description: "Select Date & Time"
                    is_required: False
                    is_user_input: False
                matchedTemplate: string
                    description: "Matched Template Name"
                    is_required: False
                    is_user_input: False
                suggestions: string
                    description: "Suggestions list"
                    is_required: False
                    is_user_input: False
            outputs:
                success: boolean
                    description: "True if resolved successfully."
                isSubmitted: boolean
                    description: "True if user input has been submitted."
                accountId: string
                    description: "The resolved Account ID."
                accountName: string
                    description: "The resolved Account Name."
                placeId: string
                    description: "The resolved Place ID."
                placeName: string
                    description: "The resolved Place Name."
                templateId: string
                    description: "The resolved Template ID."
                templateName: string
                    description: "The resolved Template Name."
                plannedStartTimeStr: string
                    description: "The parsed Planned Start Time."
                message: string
                    description: "Status, error, or suggestion options message."
                    is_displayable: True
                suggestions: string
                    description: "Matched IDs if ambiguous."

        get_visit_details:
            description: "Retrieve details of the current Visit record and its associated Account."
            target: "flow://Get_Visit_Details"
            inputs:
                recordId: string
                    description: "The ID of the Visit record."
                    is_required: True
            outputs:
                recordId: string
                    description: "The ID of the Visit record."
                accountId: string
                    description: "The associated Account ID."
                accountName: string
                    description: "The associated Account Name."
                visitStatus: string
                    description: "The Visit Status."
                visitDate: string
                    description: "The Visit Date."
                assignedUser: string
                    description: "The Assigned User."


